
// ---- spatial.gpk: convolution, pooling, resizing and RoPE ----

// Direct 3-D convolution (1-D and 2-D right-aligned with neutral leading dims), thread per output.
// meta = [batch, c_in, c_out, cpg, ocg, in[3], k[3], out[3], stride[3], pad_begin[3], dil[3]].
KERNEL conv(GLOBAL const float* x, u32 xo, GLOBAL const float* w, u32 wo, GLOBAL const float* bias,
            u32 bo, u32 has_bias, GLOBAL float* y, u32 yo, GLOBAL const u32* meta, u32 mo, u32 n) {
    u32 i = GID(0);
    if (i >= n) return;
    GLOBAL const u32* m = meta + mo;
    u32 c_in = m[1], c_out = m[2], cpg = m[3], ocg = m[4];
    GLOBAL const u32* in = m + 5;
    GLOBAL const u32* k = m + 8;
    GLOBAL const u32* od = m + 11;
    GLOBAL const u32* st = m + 14;
    GLOBAL const u32* pb = m + 17;
    GLOBAL const u32* dl = m + 20;
    u32 ow = i % od[2], oh = (i / od[2]) % od[1], oz = (i / (od[2] * od[1])) % od[0];
    u32 oc = (i / (od[2] * od[1] * od[0])) % c_out, b = i / (od[2] * od[1] * od[0] * c_out);
    u32 g = oc / ocg;
    u32 plane = in[0] * in[1] * in[2], kn = k[0] * k[1] * k[2];
    float sum = has_bias ? bias[bo + oc] : 0.0f;
    for (u32 ic = 0; ic < cpg; ic++) {
        u32 xc = (b * c_in + g * cpg + ic) * plane, wc = (oc * cpg + ic) * kn;
        for (u32 kd = 0; kd < k[0]; kd++) {
            i32 iz = (i32)(oz * st[0] + kd * dl[0]) - (i32)pb[0];
            if (iz < 0 || iz >= (i32)in[0]) continue;
            for (u32 kh = 0; kh < k[1]; kh++) {
                i32 ih = (i32)(oh * st[1] + kh * dl[1]) - (i32)pb[1];
                if (ih < 0 || ih >= (i32)in[1]) continue;
                for (u32 kw = 0; kw < k[2]; kw++) {
                    i32 iw = (i32)(ow * st[2] + kw * dl[2]) - (i32)pb[2];
                    if (iw < 0 || iw >= (i32)in[2]) continue;
                    sum += x[xo + xc + ((u32)iz * in[1] + (u32)ih) * in[2] + (u32)iw] *
                           w[wo + wc + (kd * k[1] + kh) * k[2] + kw];
                }
            }
        }
    }
    y[yo + i] = sum;
}

// Mean over kh x kw windows of planes [h, w] (valid positions only), thread per output.
KERNEL avgpool2d(GLOBAL const float* x, u32 xo, GLOBAL float* y, u32 yo, u32 n, u32 h, u32 w,
                 u32 oh, u32 ow, u32 kh, u32 kw, u32 sh, u32 sw) {
    u32 i = GID(0);
    if (i >= n) return;
    u32 c = i / (oh * ow), r = (i / ow) % oh, q = i % ow;
    float s = 0.0f;
    for (u32 a = 0; a < kh; a++)
        for (u32 b = 0; b < kw; b++) s += x[xo + c * h * w + (r * sh + a) * w + q * sw + b];
    y[yo + i] = s / (float)(kh * kw);
}

// Source taps of output coordinate o along an axis of n (half-pixel centres, border clamp):
// mode 0 nearest, 1 bilinear, 2 bicubic (a = -0.75). Returns the tap count.
DEVFN u32 up_taps(u32 o, u32 n, u32 scale, u32 mode, u32* idx, float* wt) {
    float src = ((float)o + 0.5f) / (float)scale - 0.5f;
    if (mode == 0u) {
        u32 j = o / scale;
        idx[0] = j < n - 1u ? j : n - 1u;
        wt[0] = 1.0f;
        return 1u;
    }
    if (mode == 1u) {
        src = fmaxf(src, 0.0f);
        float f = floorf(src);
        float l = src - f;
        u32 i0 = (u32)f < n - 1u ? (u32)f : n - 1u;
        idx[0] = i0;
        wt[0] = 1.0f - l;
        idx[1] = i0 + 1u < n - 1u ? i0 + 1u : n - 1u;
        wt[1] = l;
        return 2u;
    }
    float f = floorf(src);
    float t = src - f;
    float A = -0.75f;
    float x1 = t + 1.0f, x2 = 1.0f - t, x3 = 2.0f - t;
    wt[0] = ((A * x1 - 5.0f * A) * x1 + 8.0f * A) * x1 - 4.0f * A;
    wt[1] = ((A + 2.0f) * t - (A + 3.0f)) * t * t + 1.0f;
    wt[2] = ((A + 2.0f) * x2 - (A + 3.0f)) * x2 * x2 + 1.0f;
    wt[3] = ((A * x3 - 5.0f * A) * x3 + 8.0f * A) * x3 - 4.0f * A;
    for (u32 q = 0; q < 4u; q++) {
        i64 j = (i64)f + (i64)q - 1;
        idx[q] = (u32)(j < 0 ? 0 : (j > (i64)n - 1 ? (i64)n - 1 : j));
    }
    return 4u;
}

// Upsample the trailing [d, h, w] (d == 1, sd == 1 for 2-D) of each leading plane.
KERNEL upsample(GLOBAL const float* x, u32 xo, GLOBAL float* y, u32 yo, u32 n, u32 d, u32 h, u32 w,
                u32 sd, u32 scale, u32 mode) {
    u32 i = GID(0);
    if (i >= n) return;
    u32 od = d * sd, oh = h * scale, ow = w * scale;
    u32 xx = i % ow, yy = (i / ow) % oh, zz = (i / (ow * oh)) % od, l = i / (ow * oh * od);
    u32 iz[4], iy[4], ix[4];
    float wz[4], wy[4], wx[4];
    u32 nz = up_taps(zz, d, sd, mode, iz, wz);
    u32 ny = up_taps(yy, h, scale, mode, iy, wy);
    u32 nx = up_taps(xx, w, scale, mode, ix, wx);
    GLOBAL const float* plane = x + xo + l * d * h * w;
    float acc = 0.0f;
    for (u32 a = 0; a < nz; a++)
        for (u32 b = 0; b < ny; b++)
            for (u32 c = 0; c < nx; c++)
                acc += wz[a] * wy[b] * wx[c] * plane[(iz[a] * h + iy[b]) * w + ix[c]];
    y[yo + i] = acc;
}

// Rotates y (already a copy of x) in place: thread per (pair j, head, row). meta = [variant
// (0 interleaved, 1 half split, 2 mrope), sections[3], mrope interleaved, pairs half, positions].
KERNEL rope(GLOBAL float* y, u32 yo, GLOBAL const u32* pos, u32 po, GLOBAL const float* inv, u32 io,
            GLOBAL const u32* meta, u32 mo, u32 n, u32 heads, u32 hd, u32 total, u32 pairs,
            float mscale, u32 len) {
    u32 j = GID(0), h = GRP(1), s = GRP(2);
    if (j >= pairs || h >= heads || s >= n) return;
    GLOBAL const u32* m = meta + mo;
    u32 variant = m[0], np = m[6];
    float freq = inv[io + j];
    if (freq == 0.0f && mscale == 1.0f) return;
    u32 p;
    if (variant == 2u) {
        u32 pt = s * 3u < np ? pos[po + s * 3u] : 0u;
        u32 ph = s * 3u + 1u < np ? pos[po + s * 3u + 1u] : 0u;
        u32 pw = s * 3u + 2u < np ? pos[po + s * 3u + 2u] : 0u;
        if (m[4]) {
            p = (j % 3u == 1u && j < 3u * m[2]) ? ph : ((j % 3u == 2u && j < 3u * m[3]) ? pw : pt);
        } else {
            p = j < m[1] ? pt : (j < m[1] + m[2] ? ph : pw);
        }
    } else {
        p = s < np ? pos[po + s] : 0u;
    }
    float theta = (float)p * freq;
    float c = cosf(theta) * mscale, sn = sinf(theta) * mscale;
    u32 base = s * total + h * hd;
    u32 adjacent = variant == 0u || (variant == 2u && !m[5]);
    u32 i0 = adjacent ? base + 2u * j : base + j;
    u32 i1 = adjacent ? i0 + 1u : base + j + pairs;
    if (i1 >= len) return;
    float x0 = y[yo + i0], x1 = y[yo + i1];
    y[yo + i0] = x0 * c - x1 * sn;
    y[yo + i1] = x0 * sn + x1 * c;
}
