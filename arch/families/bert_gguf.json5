// llama.cpp BERT-architecture GGUF (`convert_hf_to_gguf.py` BertModel / XLMRobertaModel) with a
// classification / reranker head: llama.cpp names renamed to HF BERT names, post-LN BERT layers,
// head `cls.output` on token 0 (LLAMA_POOLING_TYPE_RANK), behind `cls` + tanh when the export
// kept the pooler (XLM-R). The converter drops RoBERTa's pad + 1 position rows: positions count
// from 0. A 1-row token-type table (XLM-R) is added to every row, segment ids unused. The llama.cpp
// writer drops trailing unit dims (ggml_n_dims): 1-label heads come in as [in], reshaped back.
{
  family: "bert_gguf",
  extends: "bert",
  match: {gguf_arch: ["bert"]},
  names: {rules: [
    ["token_embd.weight", "embeddings.word_embeddings.weight"],
    ["position_embd.weight", "embeddings.position_embeddings.weight"],
    ["token_types.weight", "embeddings.token_type_embeddings.weight"],
    ["token_embd_norm.{r:*}", "embeddings.LayerNorm.{r}"],
    ["blk.{i}.attn_q.{r:*}", "encoder.layer.{i}.attention.self.query.{r}"],
    ["blk.{i}.attn_k.{r:*}", "encoder.layer.{i}.attention.self.key.{r}"],
    ["blk.{i}.attn_v.{r:*}", "encoder.layer.{i}.attention.self.value.{r}"],
    ["blk.{i}.attn_output.{r:*}", "encoder.layer.{i}.attention.output.dense.{r}"],
    ["blk.{i}.attn_output_norm.{r:*}", "encoder.layer.{i}.attention.output.LayerNorm.{r}"],
    ["blk.{i}.ffn_up.{r:*}", "encoder.layer.{i}.intermediate.dense.{r}"],
    ["blk.{i}.ffn_down.{r:*}", "encoder.layer.{i}.output.dense.{r}"],
    ["blk.{i}.layer_output_norm.{r:*}", "encoder.layer.{i}.output.LayerNorm.{r}"],
  ]},
  checks: [{expr: "!has('cls.output.weight')", error: "GGUF has no classification head"}],
  transforms: [
    {tensor: "embeddings.token_type_embeddings.weight", op: "reshape",
     args: {shape: [1, "shape('embeddings.token_type_embeddings.weight')[0]"]},
     when: "has('embeddings.token_type_embeddings.weight') && len(shape('embeddings.token_type_embeddings.weight')) == 1"},
    {tensor: "cls.output.weight", op: "reshape", args: {shape: [1, "shape('cls.output.weight')[0]"]},
     when: "has('cls.output.weight') && len(shape('cls.output.weight')) == 1"},
  ],
}
