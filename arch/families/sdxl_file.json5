// SDXL LDM single-file checkpoint: CLIP-L (`conditioner.embedders.0.transformer.`) + OpenCLIP-G
// (`conditioner.embedders.1.model.`), configs from the SDXL base reference repo.
{
  family: "sdxl_file",
  extends: "sdxl",
  match: {
    diffusers_class: [],
    single_file_tensors: [["conditioner.embedders.1.model.ln_final.weight", "model.diffusion_model.input_blocks.0.0.weight"]],
    single_file_ext: ["safetensors"],
  },
  "use_lib+": ["ldm"],
  components: {
    text_encoder: {
      family: "clip_text",
      dir: "text_encoder",
      strip: ["conditioner.embedders.0.transformer."],
      ignore: ["conditioner.embedders.1.*", "model.diffusion_model.*", "first_stage_model.*", "denoiser.*"],
      patch: {use_lib: ["transformer", "ldm"]},
    },
    text_encoder_2: {
      family: "clip_text",
      dir: "text_encoder_2",
      strip: ["conditioner.embedders.1.model."],
      ignore: ["conditioner.embedders.0.*", "model.diffusion_model.*", "first_stage_model.*", "denoiser.*"],
      patch: {use_lib: ["transformer", "ldm"]},
    },
  },
  runtime: {
    reference: "'stabilityai/stable-diffusion-xl-base-1.0'",
    summary: "fmt('SDXL single-file checkpoint (CLIP-L + OpenCLIP-G, UNet + VAE), {json.scheduler_config._class_name}')",
  },
}
