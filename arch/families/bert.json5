// Post-LN BERT encoders: BERT, RoBERTa, XLM-RoBERTa, CamemBERT and DistilBERT (their tensors
// renamed to BERT's, prefix dropped), plus bare `BertModel` sentence encoders (System 1, SetFit
// bodies). Learned absolute positions (RoBERTa-style ones from `pad_id + 1`, see `runtime`), GELU
// MLP. `head`: 'classify' (dense + act + output on token 0: `logits`), 'hidden' (last hidden
// states), or a pooling `mean|cls|max` with optional `_l2` normalisation (`embedding`).
{
  family: "bert",
  match: {
    hf_model_type: ["bert"],
    hf_architectures: ["BertForSequenceClassification", "RobertaForSequenceClassification",
      "XLMRobertaForSequenceClassification", "CamembertForSequenceClassification",
      "DistilBertForSequenceClassification", "BertModel"],
  },
  pipeline: "encoder",
  use_lib: ["transformer"],
  names: {rules: [
    // DistilBERT layer modules -> BERT's.
    ["distilbert.transformer.layer.{i}.attention.q_lin.{r:*}", "encoder.layer.{i}.attention.self.query.{r}"],
    ["distilbert.transformer.layer.{i}.attention.k_lin.{r:*}", "encoder.layer.{i}.attention.self.key.{r}"],
    ["distilbert.transformer.layer.{i}.attention.v_lin.{r:*}", "encoder.layer.{i}.attention.self.value.{r}"],
    ["distilbert.transformer.layer.{i}.attention.out_lin.{r:*}", "encoder.layer.{i}.attention.output.dense.{r}"],
    ["distilbert.transformer.layer.{i}.sa_layer_norm.{r:*}", "encoder.layer.{i}.attention.output.LayerNorm.{r}"],
    ["distilbert.transformer.layer.{i}.ffn.lin1.{r:*}", "encoder.layer.{i}.intermediate.dense.{r}"],
    ["distilbert.transformer.layer.{i}.ffn.lin2.{r:*}", "encoder.layer.{i}.output.dense.{r}"],
    ["distilbert.transformer.layer.{i}.output_layer_norm.{r:*}", "encoder.layer.{i}.output.LayerNorm.{r}"],
    ["distilbert.{r:*}", "{r}"],
    ["bert.{r:*}", "{r}"],
    ["roberta.{r:*}", "{r}"],
  ]},
  config: {
    arch: "first(at(first(cfg.architectures, []), 0), 'BertModel')",
    distil: "arch == 'DistilBertForSequenceClassification'",
    hidden: "first(cfg.hidden_size, cfg.dim)",
    // RoBERTa-style positions: from pad_id + 1 (`runtime.position_ids`).
    pad_positions: "contains(['RobertaForSequenceClassification', 'XLMRobertaForSequenceClassification', 'CamembertForSequenceClassification'], arch)",
    // A fairseq SentencePiece vocabulary (`runtime.tokenizer`).
    fairseq_vocab: "arch == 'CamembertForSequenceClassification'",
    labels: "shape(fmt('{head_out}.weight'))[0]",
    layers: "first(cfg.num_hidden_layers, cfg.n_layers)",
    heads: "first(cfg.num_attention_heads, cfg.n_heads)",
    kv_heads: "heads",
    max_position_embeddings: "cfg.max_position_embeddings",
    eps: "distil ? 1e-12 : first(cfg.layer_norm_eps, 1e-12)",
    type_vocab: "has('embeddings.token_type_embeddings.weight') ? shape('embeddings.token_type_embeddings.weight')[0] : 0",
    pad_id: "first(cfg.pad_token_id, 1)",
    // Classification head stems.
    head_dense: "has('pre_classifier.weight') ? 'pre_classifier' : has('classifier.dense.weight') ? 'classifier.dense' : 'pooler.dense'",
    head_out: "has('classifier.out_proj.weight') ? 'classifier.out_proj' : 'classifier'",
    head_act: "has('pre_classifier.weight') ? 'Relu' : 'Tanh'",
  },
  checks: [
    {expr: "heads == 0 || hidden % heads != 0", error: "hidden_size {hidden} not divisible by num_attention_heads {heads}"},
    {expr: "distil && (first(cfg.sinusoidal_pos_embds, false) || first(cfg.activation, 'gelu') != 'gelu')",
     error: "only DistilBERT with learned positions and GELU is supported"},
    {expr: "!distil && (first(cfg.hidden_act, 'gelu') != 'gelu' || first(cfg.position_embedding_type, 'absolute') != 'absolute')",
     error: "only GELU encoders with absolute positions are supported"},
  ],
  // Buffers and the pooler of bare encoders (read only by the 'classify' head of BERT).
  // MLM heads of `...ForMaskedLM` bases a classifier adapter was trained on.
  ignore: ["embeddings.position_ids", "embeddings.token_type_ids", "pooler.*", "cls.predictions.*", "lm_head.*"],
  components: {
    encoder: {
      vars: ["rows", "head"],
      inputs: [
        {name: "token_ids", dtype: "u32", shape: ["rows"]},
        {name: "positions", dtype: "u32", shape: ["rows"]},
        {name: "token_types", dtype: "u32", shape: ["rows"], when: "type_vocab > 1"},
        // A single segment row (RoBERTa): every token reads row 0.
        {name: "type_zero", dtype: "u32", shape: ["rows"], gen: "iota", args: {n: "rows", step: 0}, when: "type_vocab == 1"},
        {name: "attention_mask", dtype: "u32", shape: ["rows"], when: "head == 'mean' || head == 'mean_l2'"},
      ],
      body: [
        {op: "Embedding", in: ["w:embeddings.word_embeddings.weight", "i:token_ids"], out: "x", name: "emb.word"},
        {op: "Embedding", in: ["w:embeddings.position_embeddings.weight", "i:positions"], out: "pe", name: "emb.position"},
        {op: "Binary", args: {kind: "Add"}, in: ["x", "pe"], out: "x", name: "emb.add_position"},
        {block: [
          {let: {tt: "type_vocab > 1 ? 'token_types' : 'type_zero'"}},
          {op: "Embedding", in: ["w:embeddings.token_type_embeddings.weight", "i:{tt}"], out: "te", name: "emb.type"},
          {op: "Binary", args: {kind: "Add"}, in: ["x", "te"], out: "x", name: "emb.add_type"},
        ], when: "type_vocab > 0"},
        {op: "LayerNorm", args: {eps: "eps"}, in: ["x", "w:embeddings.LayerNorm.weight", "w:embeddings.LayerNorm.bias"], out: "x", name: "emb.ln"},
        {repeat: "i", count: "layers", body: [
          {let: {p: "fmt('encoder.layer.{i}')"}},
          {use: "post_ln_encoder_layer", in: ["x"], out: "x", name: "l{i}", args: {
            wq: "fmt('{p}.attention.self.query')", wk: "fmt('{p}.attention.self.key')",
            wv: "fmt('{p}.attention.self.value')", wo: "fmt('{p}.attention.output.dense')",
            ln1: "fmt('{p}.attention.output.LayerNorm')", up: "fmt('{p}.intermediate.dense')",
            down: "fmt('{p}.output.dense')", ln2: "fmt('{p}.output.LayerNorm')"}},
        ]},
        {block: [
          {op: "Slice", args: {axis: 0, start: 0, end: 1}, in: ["x"], out: "c", name: "head.first"},
          {op: "Linear", in: ["c", "w:{head_dense}.weight", "w?:{head_dense}.bias"], out: "c", name: "head.dense"},
          {op: "Unary", args: {kind: "head_act"}, in: ["c"], out: "c", name: "head.act"},
          {op: "Linear", in: ["c", "w:{head_out}.weight", "w?:{head_out}.bias"], out: "c", name: "head.out"},
          {op: "Reshape", args: {shape: ["shape('c')[1]"]}, in: ["c"], out: "logits", name: "head.flat"},
        ], when: "head == 'classify'"},
        {op: "MeanPool", in: ["x", "i:attention_mask"], out: "e", name: "mean_pool", when: "head == 'mean' || head == 'mean_l2'"},
        {block: [
          {op: "Slice", args: {axis: 0, start: 0, end: 1}, in: ["x"], out: "e", name: "cls"},
          {op: "Reshape", args: {shape: ["hidden"]}, in: ["e"], out: "e", name: "cls.flat"},
        ], when: "head == 'cls' || head == 'cls_l2'"},
        {op: "Reduce", args: {kind: "Max", axes: [0], keep_dims: false}, in: ["x"], out: "e", name: "max_pool", when: "head == 'max' || head == 'max_l2'"},
        {op: "L2Normalize", in: ["e"], out: "e", name: "l2_normalize", when: "head == 'mean_l2' || head == 'cls_l2' || head == 'max_l2'"},
      ],
      outputs: [
        {name: "logits", when: "head == 'classify'"},
        {name: "hidden", value: "x", when: "head == 'hidden'"},
        {name: "embedding", value: "e", when: "head != 'classify' && head != 'hidden'"},
      ],
    },
  },
  runtime: {
    // An expression over the config (`absolute` | `pad_offset`).
    position_ids: "pad_positions ? 'pad_offset' : 'absolute'",
    // System 1 sentence embeddings: mean-pooled, L2-normalised.
    system1: "mean_l2",
    // Fast tokenizers HF converts the slow-tokenizer files to, when a repo has no tokenizer.json.
    tokenizer: [
      {when: "!pad_positions", kind: "wordpiece", vocab: "vocab.txt", unk: "[UNK]", cls: "[CLS]", sep: "[SEP]",
        specials: ["[PAD]", "[UNK]", "[CLS]", "[SEP]", "[MASK]"]},
      {when: "fairseq_vocab", kind: "unigram", model: "sentencepiece.bpe.model", vocab: "fairseq",
        cls: "<s>", sep: "</s>", pair: "{cls} $A {sep} {sep} $B {sep}"},
      {when: "pad_positions", kind: "byte_bpe", vocab: "vocab.json", merges: "merges.txt", cls: "<s>", sep: "</s>",
        post: "roberta", specials: ["<s>", "<pad>", "</s>", "<unk>", "<mask>"]},
    ],
  },
}
