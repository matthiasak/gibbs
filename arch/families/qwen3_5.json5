// Qwen3.5 (transformers `qwen3_5`, `qwen3_5_moe`, their `_text` exports; llama.cpp `qwen35`,
// `qwen35moe`): the `qwen3` decoder as a hybrid stack of Gated DeltaNet linear attention and
// output-gated full attention (`layer_types`), `1 + w` RMSNorms, interleaved M-RoPE, dense SwiGLU
// or a routed MoE with a sigmoid-gated shared expert. Multimodal checkpoints nest the decoder under
// `model.language_model` (renamed to `model.`), mlx-vlm ones under `language_model.model`.
{
  family: "qwen3_5",
  extends: "qwen3",
  match: {
    hf_model_type: ["qwen3_5", "qwen3_5_text", "qwen3_5_moe", "qwen3_5_moe_text"],
    hf_architectures: ["Qwen3_5ForSequenceClassification", "Qwen3_5TextForSequenceClassification"],
    gguf_arch: ["qwen35", "qwen35moe"],
  },
  use_lib: ["transformer", "qwen", "deltanet", "moe", "qwen_vit"],
  config: {
    // llama.cpp appends the MTP (`nextn`) blocks after the decoder's.
    nextn: "first(gguf.nextn_predict_layers, 0)",
    layers: "first(tc.num_hidden_layers, gguf.block_count - nextn)",
    layer_types: "tc.layer_types",
    inter: "first(tc.intermediate_size, gguf.feed_forward_length, 0)",
    rotary_dim: "first(gguf['rope.dimension_count'], 2 * (int(head_dim * first(rope.partial_rotary_factor, 1)) // 2))",
    mrope_section: "first(rope.mrope_section, [rotary_dim // 2, 0, 0])",
    // The vision tower wiring of lib `qwen_vit` (`qwen3` switches it off).
    has_vision: "has('model.visual.patch_embed.proj.weight')",
    mrope_variant: {MRope: {sections: "mrope_section", interleaved: true, pairs: "'Half'"}},
    deepstack_layers: "has_vision ? len(deepstack_idx) : 0",
    lin_k_heads: "first(tc.linear_num_key_heads, gguf['ssm.group_count'])",
    lin_v_heads: "first(tc.linear_num_value_heads, gguf['ssm.time_step_rank'])",
    lin_k_dim: "first(tc.linear_key_head_dim, gguf['ssm.state_size'])",
    lin_v_dim: "first(tc.linear_value_head_dim, gguf['ssm.inner_size'] // lin_v_heads)",
    lin_kernel: "first(tc.linear_conv_kernel_dim, gguf['ssm.conv_kernel'])",
    // GGUF value heads come tiled (`[v_per_k, k_heads]`); untiled at load, except `out_proj`
    // columns that split quantization blocks, whose input is tiled in the graph instead.
    tiled_heads: "gguf_arch != '' && lin_k_heads != lin_v_heads",
    out_tiled: "tiled_heads && lin_v_dim % block('model.layers.0.linear_attn.out_proj.weight') != 0",
    moe_inter: "first(tc.moe_intermediate_size, gguf.expert_feed_forward_length, 0)",
    attn_gate: "first(tc.attn_output_gate, gguf_arch != '')",
    qk_norm: "'before'",
    // transformers' `1 + w` RMSNorm gains (llama.cpp stores them shifted, mlx-vlm too).
    norm_offset: "gguf_arch == '' && !raw_has('language_model.model.*')",
  },
  "checks+": [
    {expr: "gguf_arch == '' && rope.mrope_interleaved != true",
     error: "only interleaved M-RoPE (`mrope_interleaved: true`) is implemented"},
    {expr: "len(mrope_section) != 3 || at(mrope_section, 0) + at(mrope_section, 1) + at(mrope_section, 2) != rotary_dim // 2",
     error: "mrope_section {mrope_section} does not cover rotary dim {rotary_dim}"},
    {expr: "layer_types != null && len(layer_types) != layers", error: "layer_types length != num_hidden_layers"},
  ],
  // qwen3's rename rules would claim fused `ffn_gate_up_exps` ahead of `qwen35`'s.
  names: {use: ["qwen35", "llamacpp"], rules: null},
  "transforms+": [
    {tensor: "model.layers.{i}.{n:*}layernorm.weight", op: "add", args: {value: 1}, when: "norm_offset"},
    {tensor: "model.layers.{i}.self_attn.{n:*}_norm.weight", op: "add", args: {value: 1}, when: "norm_offset"},
    {tensor: "model.norm.weight", op: "add", args: {value: 1}, when: "norm_offset"},
    {tensor: "mtp.pre_fc_norm_{n:*}.weight", op: "add", args: {value: 1}, when: "gguf_arch == ''"},
    {tensor: "mtp.norm.weight", op: "add", args: {value: 1}, when: "gguf_arch == ''"},
    {tensor: "mtp.layers.{i}.{n:*}layernorm.weight", op: "add", args: {value: 1}, when: "gguf_arch == ''"},
    {tensor: "mtp.layers.{i}.self_attn.{n:*}_norm.weight", op: "add", args: {value: 1}, when: "gguf_arch == ''"},
    {tensor: "model.layers.{i}.linear_attn.A_log", op: "split_rows", args: {parts: [["model.layers.{i}.linear_attn.neg_A", "lin_v_heads"]]}},
    {tensor: "model.layers.{i}.linear_attn.neg_A", op: "neg_exp", when: "gguf_arch == ''"},
    // Depthwise conv [conv_dim, 1, kernel] (HF) / [conv_dim, kernel] (GGUF) -> f32 [conv_dim, kernel].
    {tensor: "model.layers.{i}.linear_attn.conv1d.weight", op: "reshape",
     args: {shape: ["2 * lin_k_heads * lin_k_dim + lin_v_heads * lin_v_dim", "lin_kernel"]}},
    {tensor: "model.layers.{i}.linear_attn.conv1d.weight", op: "to_f32"},
    // llama.cpp's tiled value heads back to transformers' grouped order.
    {tensor: "model.layers.{i}.linear_attn.in_proj_qkv.weight", op: "untile_packed_rows", when: "tiled_heads",
     args: {k_heads: "lin_k_heads", v_heads: "lin_v_heads", rows_per_block: "lin_v_dim", prefix_rows: "2 * lin_k_heads * lin_k_dim"}},
    {tensor: "model.layers.{i}.linear_attn.in_proj_z.weight", op: "untile_packed_rows", when: "tiled_heads",
     args: {k_heads: "lin_k_heads", v_heads: "lin_v_heads", rows_per_block: "lin_v_dim"}},
    {tensor: "model.layers.{i}.linear_attn.conv1d.weight", op: "untile_heads", when: "tiled_heads",
     args: {k_heads: "lin_k_heads", block: "lin_v_dim * lin_kernel", prefix: "2 * lin_k_heads * lin_k_dim * lin_kernel"}},
    {tensor: "model.layers.{i}.linear_attn.in_proj_{n:*}.weight", op: "untile_heads", when: "tiled_heads && (n == 'a' || n == 'b')",
     args: {k_heads: "lin_k_heads", block: "hidden"}},
    {tensor: "model.layers.{i}.linear_attn.neg_A", op: "untile_heads", when: "tiled_heads", args: {k_heads: "lin_k_heads", block: 1}},
    {tensor: "model.layers.{i}.linear_attn.dt_bias", op: "untile_heads", when: "tiled_heads", args: {k_heads: "lin_k_heads", block: 1}},
    // out_proj columns: one value head per row block of the [rows * v_heads, v_dim] view.
    {tensor: "model.layers.{i}.linear_attn.out_proj.weight", op: "reshape", when: "tiled_heads && !out_tiled",
     args: {shape: ["hidden * lin_v_heads", "lin_v_dim"]}},
    {tensor: "model.layers.{i}.linear_attn.out_proj.weight", op: "untile_packed_rows", when: "tiled_heads && !out_tiled",
     args: {k_heads: "lin_k_heads", v_heads: "lin_v_heads", rows_per_block: 1, chunk_rows: "lin_v_heads"}},
    {tensor: "model.layers.{i}.linear_attn.out_proj.weight", op: "reshape", when: "tiled_heads && !out_tiled",
     args: {shape: ["hidden", "lin_v_heads * lin_v_dim"]}},
    // HF fused gate_up / down expert banks as [experts * rows, cols] (GGUF banks: qwen3's reshape).
    {tensor: "model.layers.{i}.mlp.experts.gate_up_proj", op: "reshape", args: {shape: ["experts * 2 * moe_inter", "hidden"]}},
    {tensor: "model.layers.{i}.mlp.experts.gate_up_proj", op: "deinterleave_heads", args: {heads: "experts", parts: [
      ["model.layers.{i}.mlp.experts.gate_proj.weight", "moe_inter"], ["model.layers.{i}.mlp.experts.up_proj.weight", "moe_inter"]]}},
    {tensor: "model.layers.{i}.mlp.experts.down_proj", op: "reshape", args: {shape: ["experts * hidden", "moe_inter"]}},
    {tensor: "model.layers.{i}.mlp.experts.down_proj", op: "split_rows", args: {parts: [
      ["model.layers.{i}.mlp.experts.down_proj.weight", "experts * hidden"]]}},
    {tensor: "model.layers.{i}.mlp.shared_expert_gate.weight", op: "reshape", when: "len(shape(fmt('model.layers.{i}.mlp.shared_expert_gate.weight'))) == 1",
     args: {shape: [1, "hidden"]}},
  ],
  // mtp.*: an MTP head the `mtp` drafter does not run (more than one layer, dedicated embeddings)
  // is skipped, not refused.
  "ignore+": ["mtp.*"],
  components: {
    // Multi-token prediction head (`mtp.*`, vLLM `Qwen3_5MultiTokenPredictor`) as the shipped
    // drafter: rows pair a token with the hidden state of the position before it,
    // fc([norm_e(embed(t)); norm_h(h)]), one gated full-attention layer over its own cache, then
    // `mtp.norm`; the shared LM head turns the last row into draft logits, and `hidden` (that row,
    // normed) stands in for the next position's hidden state. `src`: 'tap' = `hidden` is the
    // target's last-layer residual (final-normed here), 'draft' = a previous `hidden` output.
    // ponytail: one MTP layer (every released Qwen3.5); vLLM cycles `step % layers` for more.
    mtp: {
      vars: ["rows", "src"],
      inputs: [
        {name: "token_ids", dtype: "u32", shape: ["rows"]},
        {name: "hidden", dtype: "f32", shape: ["rows", "hidden"]},
        {name: "positions", dtype: "u32", shape: ["rows"]},
      ],
      body: [
        {op: "Embedding", in: ["w:model.embed_tokens.weight", "i:token_ids"], out: "e", name: "mtp.embed"},
        {use: "rms_norm", args: {w: "'mtp.pre_fc_norm_embedding'"}, in: ["e"], out: "e", name: "mtp.norm_embed"},
        {block: [
          {use: "rms_norm", args: {w: "'model.norm'"}, in: ["i:hidden"], out: "h", name: "mtp.target_norm"},
          {use: "rms_norm", args: {w: "'mtp.pre_fc_norm_hidden'"}, in: ["h"], out: "h", name: "mtp.norm_hidden"},
        ], when: "src == 'tap'"},
        {use: "rms_norm", args: {w: "'mtp.pre_fc_norm_hidden'"}, in: ["i:hidden"], out: "h", name: "mtp.norm_hidden", when: "src != 'tap'"},
        {op: "Concat", args: {axis: -1}, in: ["e", "h"], out: "x", name: "mtp.concat"},
        {op: "Linear", in: ["x", "w:mtp.fc.weight"], out: "x", name: "mtp.fc"},
        {use: "rms_norm", args: {w: "'mtp.layers.0.input_layernorm'"}, in: ["x"], out: "h", name: "mtp.layers.0.input_layernorm"},
        {use: "qwen_attn", in: ["h"], out: "a", name: "mtp.layers.0.self_attn", args: {p: "'mtp.layers.0.self_attn'", layer: "'mtp'"}},
        {op: "Binary", args: {kind: "'Add'"}, in: ["x", "a"], out: "x", name: "mtp.layers.0.add_mixer"},
        {use: "rms_norm", args: {w: "'mtp.layers.0.post_attention_layernorm'"}, in: ["x"], out: "h", name: "mtp.layers.0.post_attention_layernorm"},
        {use: "mlp_glu", in: ["h"], out: "m", name: "mtp.layers.0.mlp",
         args: {gate: "'mtp.layers.0.mlp.gate_proj'", up: "'mtp.layers.0.mlp.up_proj'", down: "'mtp.layers.0.mlp.down_proj'"}},
        {op: "Binary", args: {kind: "'Add'"}, in: ["x", "m"], out: "x", name: "mtp.layers.0.add_ffn"},
        {use: "last_row", in: ["x"], out: "x", name: "mtp.last"},
        {use: "rms_norm", args: {w: "'mtp.norm'"}, in: ["x"], out: "hidden", name: "mtp.norm"},
        {use: "lm_head", args: {w: "head_w"}, in: ["hidden"], out: "logits", name: "mtp.lm_head"},
      ],
      outputs: ["logits", "hidden"],
    },
  },
  runtime: {
    ninfer: {
      architecture: "Qwen3_5ForCausalLM",
      model_type: "qwen3_5_text",
      refused_architectures: ["Qwen3_5MoeForCausalLM", "Qwen4ExpForCausalLM"],
      hub_moe_keywords: ["a3b", "flash-next", "-moe", "qwen4"],
    },
    drafter: {kind: "mtp", component: "mtp", label: "'MTP'", taps: "[layers - 1]",
              when: "has('mtp.fc.weight') && first(tc.mtp_num_hidden_layers, 0) == 1 && tc.mtp_use_dedicated_embeddings != true"},
  },
}
