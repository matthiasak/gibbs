// ALBERT: `embedding_size` embeddings, LayerNorm, `embedding_hidden_mapping_in` to the hidden size,
// then `num_hidden_layers` steps; step i runs every inner layer of group i // (layers / groups)
// (AlbertTransformer). Shared groups read the same tensor names, so the weights are loaded once.
// Classification: token 0 -> `albert.pooler` -> tanh -> `classifier`.
{
  family: "albert",
  match: {hf_model_type: ["albert"], hf_architectures: ["AlbertForSequenceClassification", "AlbertModel"]},
  pipeline: "encoder",
  use_lib: ["transformer"],
  // TF-era LayerNorm `gamma`/`beta`.
  names: {rules: [["{a:*}.gamma", "{a}.weight"], ["{a:*}.beta", "{a}.bias"]]},
  config: {
    hidden: "cfg.hidden_size",
    layers: "cfg.num_hidden_layers",
    groups: "cfg.num_hidden_groups",
    inner: "cfg.inner_group_num",
    heads: "cfg.num_attention_heads",
    kv_heads: "heads",
    head_dim: "hidden // heads",
    eps: "first(cfg.layer_norm_eps, 1e-12)",
    max_position_embeddings: "cfg.max_position_embeddings",
    act: "unary_act(first(cfg.hidden_act, 'gelu'), 'GeluTanh')",
    labels: "shape('classifier.weight')[0]",
  },
  checks: [
    {expr: "!contains(['gelu', 'gelu_new', 'gelu_pytorch_tanh'], first(cfg.hidden_act, 'gelu'))", error: "hidden_act {cfg.hidden_act} is not supported"},
    {expr: "first(cfg.position_embedding_type, 'absolute') != 'absolute'", error: "only absolute position embeddings are supported"},
    {expr: "groups < 1 || inner < 1 || layers % groups != 0", error: "{layers} layers do not split into {groups} groups of {inner}"},
  ],
  components: {
    encoder: {
      vars: ["rows", "head"],
      inputs: [
        {name: "token_ids", dtype: "u32", shape: ["rows"]},
        {name: "positions", dtype: "u32", shape: ["rows"]},
        {name: "token_types", dtype: "u32", shape: ["rows"]},
      ],
      body: [
        {op: "Embedding", in: ["w:albert.embeddings.word_embeddings.weight", "i:token_ids"], out: "x", name: "emb.word"},
        {op: "Embedding", in: ["w:albert.embeddings.position_embeddings.weight", "i:positions"], out: "pe", name: "emb.pos"},
        {op: "Embedding", in: ["w:albert.embeddings.token_type_embeddings.weight", "i:token_types"], out: "te", name: "emb.type"},
        {op: "Binary", args: {kind: "Add"}, in: ["x", "pe"], out: "x", name: "emb.add_pos"},
        {op: "Binary", args: {kind: "Add"}, in: ["x", "te"], out: "x", name: "emb.add_type"},
        {use: "layer_norm", args: {w: "'albert.embeddings.LayerNorm'"}, in: ["x"], out: "x", name: "emb.ln"},
        {op: "Linear", in: ["x", "w:albert.encoder.embedding_hidden_mapping_in.weight", "w?:albert.encoder.embedding_hidden_mapping_in.bias"],
         out: "x", name: "emb.proj"},
        {repeat: "i", count: "layers", body: [
          {repeat: "j", count: "inner", body: [
            {let: {g: "i // (layers // groups)"}},
            {let: {p: "fmt('albert.encoder.albert_layer_groups.{g}.albert_layers.{j}')"}},
            {use: "post_ln_encoder_layer", in: ["x"], out: "x", name: "l{i}.{j}", args: {
              wq: "fmt('{p}.attention.query')", wk: "fmt('{p}.attention.key')",
              wv: "fmt('{p}.attention.value')", wo: "fmt('{p}.attention.dense')",
              ln1: "fmt('{p}.attention.LayerNorm')", up: "fmt('{p}.ffn')", down: "fmt('{p}.ffn_output')",
              ln2: "fmt('{p}.full_layer_layer_norm')"}},
          ]},
          {tap: "layer.{i}", in: "x"},
        ]},
        {op: "Slice", args: {axis: 0, start: 0, end: 1}, in: ["x"], out: "c", name: "cls", when: "head == 'classify'"},
        {op: "Linear", in: ["c", "w:albert.pooler.weight", "w?:albert.pooler.bias"], out: "c", name: "pooler", when: "head == 'classify'"},
        {op: "Unary", args: {kind: "Tanh"}, in: ["c"], out: "c", name: "pooler.act", when: "head == 'classify'"},
        {op: "Linear", in: ["c", "w:classifier.weight", "w?:classifier.bias"], out: "logits", name: "classifier", when: "head == 'classify'"},
        {op: "Unary", args: {kind: {Scale: 1}}, in: ["x"], out: "hidden", name: "hidden", when: "head == 'hidden'"},
      ],
      outputs: [{name: "logits", when: "head == 'classify'"}, {name: "hidden", when: "head == 'hidden'"}],
    },
  },
  // AlbertConverter, when a repo has no tokenizer.json.
  runtime: {tokenizer: [
    {kind: "unigram", model: "spiece.model", demote_number_comma: true, replace_quotes: true, strip_accents: true,
      lowercase: true, cls: "[CLS]", sep: "[SEP]", pair: "{cls} $A {sep} $B:1 {sep}:1"},
  ]},
}
