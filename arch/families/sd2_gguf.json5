// SD 2.1 turbo GGUF (gpustack/stable-diffusion-v2-1-turbo-GGUF, stable-diffusion.cpp naming: the
// OpenCLIP-H tower converted to HF names under `cond_stage_model.transformer.`, so the components
// are `sd1_file`'s): configs from stabilityai/sd-turbo (Euler trailing), no CFG. 4 steps: 1-step
// Euler multiplies eps error by sigma_max (~14.6), which turns quantized-UNet error into noise
// (`sd.rs` `SdPipeline::load`).
{
  family: "sd2_gguf",
  extends: "sd1_file",
  match: {
    diffusers_class: [],
    single_file_tensors: [["cond_stage_model.transformer.text_model.final_layer_norm.weight", "model.diffusion_model.input_blocks.0.0.weight"]],
    single_file_ext: ["gguf"],
  },
  runtime: {
    reference: "'stabilityai/sd-turbo'",
    defaults: {width: 512, height: 512, steps: 4, guidance: 0},
    summary: "fmt('Stable Diffusion 2.x GGUF (CLIP + UNet + VAE), {json.scheduler_config._class_name}')",
  },
}
