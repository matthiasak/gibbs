// Gemma 4 (`gemma4`, `Gemma4ForConditionalGeneration`: gemma-4-E2B/E4B/26B-A4B; llama.cpp `gemma4`
// GGUFs with their `mmproj`). Text: sliding + full attention layers with per-type head dims and
// RoPE (proportional partial rotary on full layers), q/k/v RMSNorm and attention scale 1, sandwich
// norms, KV sharing for the last `num_kv_shared_layers` (each reads the last non-shared layer of
// its type), `attention_k_eq_v` (full layers use the raw keys as values), per-layer input
// embeddings gathered in-graph, `layer_scalar`, sparse layers (routed experts beside the dense
// MLP) and the tied, soft-capped LM head. Head dims, heads and KV heads come from tensor shapes.
// Media rows (vision / audio towers) scatter into the embedded prompt; their per-layer embedding
// is the pad id's.
{
  family: "gemma4",
  match: {
    hf_model_type: ["gemma4", "gemma4_text"],
    hf_architectures: ["Gemma4ForConditionalGeneration", "Gemma4ForCausalLM", "Gemma4ForSequenceClassification"],
    gguf_arch: ["gemma4"],
  },
  pipeline: "causal_lm",
  use_lib: ["transformer"],
  config: {
    tc: "first(cfg.text_config, cfg)",
    gguf_arch: "first(gguf['general.architecture'], '')",
    // GGUF metadata beats a config.json shipped beside the GGUF (same model, fewer gaps).
    hidden: "shape('model.language_model.embed_tokens.weight')[1]",
    vocab: "shape('model.language_model.embed_tokens.weight')[0]",
    layers: "first(gguf.block_count, tc.num_hidden_layers)",
    // Per layer: 'sliding_attention' / 'full_attention' (HF) or 1 / 0 (GGUF).
    types: "first(gguf['attention.sliding_window_pattern'], tc.layer_types)",
    sl_tag: "contains(types, 'sliding_attention') ? 'sliding_attention' : 1",
    full_tag: "contains(types, 'full_attention') ? 'full_attention' : 0",
    last_sliding: "rfind(types, sl_tag)",
    last_full: "rfind(types, full_tag)",
    hd_swa: "shape(fmt('model.language_model.layers.{last_sliding}.self_attn.q_norm.weight'))[0]",
    hd_full: "shape(fmt('model.language_model.layers.{last_full}.self_attn.q_norm.weight'))[0]",
    first_shared: "layers - min(first(gguf['attention.shared_kv_layers'], tc.num_kv_shared_layers, 0), layers)",
    eps: "first(gguf['attention.layer_norm_rms_epsilon'], tc.rms_norm_eps, 1e-6)",
    window: "first(gguf['attention.sliding_window'], tc.sliding_window)",
    softcap: "first(gguf.final_logit_softcapping, tc.final_logit_softcapping, 0)",
    ple_dim: "first(gguf.embedding_length_per_layer_input, tc.hidden_size_per_layer_input, 0)",
    pad_id: "first(gguf['tokenizer.ggml.padding_token_id'], tc.pad_token_id, cfg.pad_token_id, 0)",
    // Gemma casts sqrt(hidden) to the bf16 weight dtype before scaling.
    embed_scale: "bf16(sqrt(hidden))",
    rope_swa: "tc.rope_parameters.sliding_attention",
    rope_full: "tc.rope_parameters.full_attention",
    theta_swa: "first(gguf['rope.freq_base_swa'], rope_swa.rope_theta)",
    theta_full: "first(gguf['rope.freq_base'], rope_full.rope_theta)",
    // llama.cpp stores proportional RoPE as per-pair factors: 1 for the rotated pairs, 1e30
    // (never rotating) for the rest.
    prf_full: "has('rope_freqs.weight') ? 2 * (rfind(values('rope_freqs.weight'), 1) + 1) / hd_full : first(rope_full.rope_type, 'default') == 'proportional' ? first(rope_full.partial_rotary_factor, 1) : 1",
    moe: "has('model.language_model.layers.0.router.proj.weight')",
    experts: "moe ? shape('model.language_model.layers.0.router.proj.weight')[0] : 0",
    top_k: "first(gguf.expert_used_count, tc.top_k_experts)",
    bidir_vision: "tc.use_bidirectional_attention == 'vision'",
    max_position_embeddings: "first(gguf.context_length, tc.max_position_embeddings)",
    // Sequence classifiers keep a 4096-position cache (max_position_embeddings is 128k+).
    ctx: "first(runtime.ctx, has('score.weight') ? min(max_position_embeddings, 4096) : max_position_embeddings)",
    gg: "gguf_arch == 'gemma4'",
    // Vision tower (`gemma4_vision`, or llama.cpp's `gemma4v` mmproj renamed to the HF names).
    // Other mmproj vision projectors (12B's `gemma4uv`) leave vision off, as the old loader did.
    v_ok: "!gg || first(gguf['clip.vision.projector_type'], '') == 'gemma4v'",
    has_vision: "v_ok && has('model.vision_tower.patch_embedder.input_proj.weight')",
    // The old loader left vision off for towers with `std_bias`/`std_scale` (26B-A4B).
    vision_on: "has_vision && !has('model.vision_tower.std_bias')",
    v_layers: "first(gguf['clip.vision.block_count'], cfg.vision_config.num_hidden_layers)",
    v_hidden: "shape('model.vision_tower.patch_embedder.input_proj.weight')[0]",
    v_in: "shape('model.vision_tower.patch_embedder.input_proj.weight')[1]",
    v_hd: "shape('model.vision_tower.encoder.layers.0.self_attn.q_norm.weight')[0]",
    v_heads: "shape('model.vision_tower.encoder.layers.0.self_attn.q_proj.linear.weight')[0] // v_hd",
    v_patch: "first(gguf['clip.vision.patch_size'], cfg.vision_config.patch_size)",
    v_pool: "first(gguf['clip.vision.projector.scale_factor'], cfg.vision_config.pooling_kernel_size, 3)",
    v_eps: "first(gguf['clip.vision.attention.layer_norm_epsilon'], cfg.vision_config.rms_norm_eps, 1e-6)",
    // llama.cpp hard-codes the vision RoPE base (clip.cpp, gemma4v).
    v_theta: "first(cfg.vision_config.rope_parameters.rope_theta, 100)",
    v_max_soft: "first(json.processor_config.image_processor.max_soft_tokens, 280)",
    // Audio conformer (`gemma4_audio`, or llama.cpp's `gemma4a` mmproj renamed to the HF names) and
    // its log-mel front end (`Gemma4AudioFeatureExtractor`; defaults as every gemma-4 processor sets it).
    a_ok: "!gg || first(gguf['clip.audio.projector_type'], '') == 'gemma4a'",
    has_audio: "a_ok && has('model.audio_tower.output_proj.weight')",
    a_fe: "json.processor_config.feature_extractor",
    a_layers: "first(gguf['clip.audio.block_count'], cfg.audio_config.num_hidden_layers)",
    a_hidden: "first(gguf['clip.audio.embedding_length'], cfg.audio_config.hidden_size)",
    a_heads: "first(gguf['clip.audio.attention.head_count'], cfg.audio_config.num_attention_heads)",
    a_hd: "a_hidden // a_heads",
    // llama.cpp hard-codes the norm epsilon 1e-6, the chunked local attention (12 past frames), the
    // logit cap 50 and half-step residuals (gemma4a.cpp); the mmproj's layer_norm_epsilon is unused.
    a_eps: "first(cfg.audio_config.rms_norm_eps, 1e-6)",
    a_left: "first(cfg.audio_config.attention_context_left, 13) - 1",
    a_cap: "first(cfg.audio_config.attention_logit_cap, 50)",
    a_rw: "first(cfg.audio_config.residual_weight, 0.5)",
    a_rate: "first(a_fe.sampling_rate, 16000)",
    a_frame: "first(a_fe.frame_length, 320)",
    a_fft: "first(a_fe.fft_length, 512)",
    a_bins: "a_fft // 2 + 1",
    a_mel: "first(gguf['clip.audio.num_mel_bins'], a_fe.feature_size, 128)",
    // Mel bins after the first stride-2 conv.
    a_f1: "(a_mel - 1) // 2 + 1",
  },
  checks: [
    {expr: "has('output.weight')", error: "an untied output.weight is not supported"},
    {expr: "tc.use_bidirectional_attention != null && !bidir_vision", error: "use_bidirectional_attention '{tc.use_bidirectional_attention}' is not supported"},
    {expr: "len(types) != layers", error: "{len(types)} layer types for {layers} layers"},
    {expr: "moe && (top_k == 0 || top_k > experts)", error: "top_k_experts {top_k} is not within 1..={experts}"},
    {expr: "has_audio && (first(a_fe.preemphasis, 0) != 0 || first(a_fe.dither, 0) != 0 || first(a_fe.input_scale_factor, 1) != 1)",
     error: "audio feature_extractor: preemphasis/dither/input scaling are not supported"},
    {expr: "has_audio && (a_fe.per_bin_mean != null || a_fe.per_bin_stddev != null)", error: "audio feature_extractor: per-bin normalisation is not supported"},
    {expr: "has_audio && first(cfg.audio_config.attention_context_right, 0) != 0", error: "audio attention with right context is not supported"},
    {expr: "has_audio && first(cfg.audio_config.hidden_act, 'silu') != 'silu'", error: "audio_config.hidden_act must be silu"},
  ],
  names: {
    rules: [
      ["token_embd.weight", "model.language_model.embed_tokens.weight"],
      ["per_layer_token_embd.weight", "model.language_model.embed_tokens_per_layer.weight"],
      ["per_layer_model_proj.weight", "model.language_model.per_layer_model_projection.weight"],
      ["per_layer_proj_norm.weight", "model.language_model.per_layer_projection_norm.weight"],
      ["output_norm.weight", "model.language_model.norm.weight"],
      ["blk.{i}.attn_norm.weight", "model.language_model.layers.{i}.input_layernorm.weight"],
      ["blk.{i}.attn_q.weight", "model.language_model.layers.{i}.self_attn.q_proj.weight"],
      ["blk.{i}.attn_k.weight", "model.language_model.layers.{i}.self_attn.k_proj.weight"],
      ["blk.{i}.attn_v.weight", "model.language_model.layers.{i}.self_attn.v_proj.weight"],
      ["blk.{i}.attn_output.weight", "model.language_model.layers.{i}.self_attn.o_proj.weight"],
      ["blk.{i}.attn_q_norm.weight", "model.language_model.layers.{i}.self_attn.q_norm.weight"],
      ["blk.{i}.attn_k_norm.weight", "model.language_model.layers.{i}.self_attn.k_norm.weight"],
      ["blk.{i}.post_attention_norm.weight", "model.language_model.layers.{i}.post_attention_layernorm.weight"],
      ["blk.{i}.ffn_norm.weight", "model.language_model.layers.{i}.pre_feedforward_layernorm.weight"],
      ["blk.{i}.ffn_gate.weight", "model.language_model.layers.{i}.mlp.gate_proj.weight"],
      ["blk.{i}.ffn_up.weight", "model.language_model.layers.{i}.mlp.up_proj.weight"],
      ["blk.{i}.ffn_down.weight", "model.language_model.layers.{i}.mlp.down_proj.weight"],
      ["blk.{i}.post_ffw_norm.weight", "model.language_model.layers.{i}.post_feedforward_layernorm.weight"],
      ["blk.{i}.ffn_gate_inp.weight", "model.language_model.layers.{i}.router.proj.weight"],
      ["blk.{i}.ffn_gate_inp.scale", "model.language_model.layers.{i}.router.scale"],
      ["blk.{i}.ffn_down_exps.scale", "model.language_model.layers.{i}.router.per_expert_scale"],
      ["blk.{i}.pre_ffw_norm_2.weight", "model.language_model.layers.{i}.pre_feedforward_layernorm_2.weight"],
      ["blk.{i}.post_ffw_norm_1.weight", "model.language_model.layers.{i}.post_feedforward_layernorm_1.weight"],
      ["blk.{i}.post_ffw_norm_2.weight", "model.language_model.layers.{i}.post_feedforward_layernorm_2.weight"],
      ["blk.{i}.ffn_gate_exps.weight", "model.language_model.layers.{i}.mlp.experts.gate_proj"],
      ["blk.{i}.ffn_up_exps.weight", "model.language_model.layers.{i}.mlp.experts.up_proj"],
      ["blk.{i}.ffn_gate_up_exps.weight", "model.language_model.layers.{i}.mlp.experts.gate_up_proj"],
      ["blk.{i}.ffn_down_exps.weight", "model.language_model.layers.{i}.mlp.experts.down_proj"],
      ["blk.{i}.inp_gate.weight", "model.language_model.layers.{i}.per_layer_input_gate.weight"],
      ["blk.{i}.proj.weight", "model.language_model.layers.{i}.per_layer_projection.weight"],
      ["blk.{i}.post_norm.weight", "model.language_model.layers.{i}.post_per_layer_input_norm.weight"],
      ["blk.{i}.layer_output_scale.weight", "model.language_model.layers.{i}.layer_scalar"],
      // mmproj `gemma4v` tower. ClippableLinear: weight under `.linear`, clamps beside it.
      ["v.patch_embd.weight", "model.vision_tower.patch_embedder.input_proj.weight"],
      ["v.position_embd.weight", "model.vision_tower.patch_embedder.position_embedding_table"],
      ["v.std_bias", "model.vision_tower.std_bias"],
      ["v.std_scale", "model.vision_tower.std_scale"],
      ["mm.input_projection.weight", "model.embed_vision.embedding_projection.weight"],
      ["v.blk.{i}.attn_q.weight", "model.vision_tower.encoder.layers.{i}.self_attn.q_proj.linear.weight"],
      ["v.blk.{i}.attn_q.{b:*}", "model.vision_tower.encoder.layers.{i}.self_attn.q_proj.{b}"],
      ["v.blk.{i}.attn_k.weight", "model.vision_tower.encoder.layers.{i}.self_attn.k_proj.linear.weight"],
      ["v.blk.{i}.attn_k.{b:*}", "model.vision_tower.encoder.layers.{i}.self_attn.k_proj.{b}"],
      ["v.blk.{i}.attn_v.weight", "model.vision_tower.encoder.layers.{i}.self_attn.v_proj.linear.weight"],
      ["v.blk.{i}.attn_v.{b:*}", "model.vision_tower.encoder.layers.{i}.self_attn.v_proj.{b}"],
      ["v.blk.{i}.attn_out.weight", "model.vision_tower.encoder.layers.{i}.self_attn.o_proj.linear.weight"],
      ["v.blk.{i}.attn_out.{b:*}", "model.vision_tower.encoder.layers.{i}.self_attn.o_proj.{b}"],
      ["v.blk.{i}.ffn_gate.weight", "model.vision_tower.encoder.layers.{i}.mlp.gate_proj.linear.weight"],
      ["v.blk.{i}.ffn_gate.{b:*}", "model.vision_tower.encoder.layers.{i}.mlp.gate_proj.{b}"],
      ["v.blk.{i}.ffn_up.weight", "model.vision_tower.encoder.layers.{i}.mlp.up_proj.linear.weight"],
      ["v.blk.{i}.ffn_up.{b:*}", "model.vision_tower.encoder.layers.{i}.mlp.up_proj.{b}"],
      ["v.blk.{i}.ffn_down.weight", "model.vision_tower.encoder.layers.{i}.mlp.down_proj.linear.weight"],
      ["v.blk.{i}.ffn_down.{b:*}", "model.vision_tower.encoder.layers.{i}.mlp.down_proj.{b}"],
      ["v.blk.{i}.attn_q_norm.weight", "model.vision_tower.encoder.layers.{i}.self_attn.q_norm.weight"],
      ["v.blk.{i}.attn_k_norm.weight", "model.vision_tower.encoder.layers.{i}.self_attn.k_norm.weight"],
      ["v.blk.{i}.ln1.weight", "model.vision_tower.encoder.layers.{i}.input_layernorm.weight"],
      ["v.blk.{i}.attn_post_norm.weight", "model.vision_tower.encoder.layers.{i}.post_attention_layernorm.weight"],
      ["v.blk.{i}.ln2.weight", "model.vision_tower.encoder.layers.{i}.pre_feedforward_layernorm.weight"],
      ["v.blk.{i}.ffn_post_norm.weight", "model.vision_tower.encoder.layers.{i}.post_feedforward_layernorm.weight"],
      // mmproj `gemma4a` tower.
      ["a.input_projection.weight", "model.audio_tower.subsample_conv_projection.input_proj_linear.weight"],
      ["a.pre_encode.out.{b:*}", "model.audio_tower.output_proj.{b}"],
      ["mm.a.input_projection.weight", "model.embed_audio.embedding_projection.weight"],
      ["a.conv1d.{i}.weight", "model.audio_tower.subsample_conv_projection.layer{i}.conv.weight"],
      ["a.conv1d.{i}.norm.weight", "model.audio_tower.subsample_conv_projection.layer{i}.norm.weight"],
      ["a.blk.{i}.attn_q.weight", "model.audio_tower.layers.{i}.self_attn.q_proj.linear.weight"],
      ["a.blk.{i}.attn_q.{b:*}", "model.audio_tower.layers.{i}.self_attn.q_proj.{b}"],
      ["a.blk.{i}.attn_k.weight", "model.audio_tower.layers.{i}.self_attn.k_proj.linear.weight"],
      ["a.blk.{i}.attn_k.{b:*}", "model.audio_tower.layers.{i}.self_attn.k_proj.{b}"],
      ["a.blk.{i}.attn_v.weight", "model.audio_tower.layers.{i}.self_attn.v_proj.linear.weight"],
      ["a.blk.{i}.attn_v.{b:*}", "model.audio_tower.layers.{i}.self_attn.v_proj.{b}"],
      ["a.blk.{i}.attn_out.weight", "model.audio_tower.layers.{i}.self_attn.post.linear.weight"],
      ["a.blk.{i}.attn_out.{b:*}", "model.audio_tower.layers.{i}.self_attn.post.{b}"],
      ["a.blk.{i}.ffn_up.weight", "model.audio_tower.layers.{i}.feed_forward1.ffw_layer_1.linear.weight"],
      ["a.blk.{i}.ffn_up.{b:*}", "model.audio_tower.layers.{i}.feed_forward1.ffw_layer_1.{b}"],
      ["a.blk.{i}.ffn_down.weight", "model.audio_tower.layers.{i}.feed_forward1.ffw_layer_2.linear.weight"],
      ["a.blk.{i}.ffn_down.{b:*}", "model.audio_tower.layers.{i}.feed_forward1.ffw_layer_2.{b}"],
      ["a.blk.{i}.ffn_up_1.weight", "model.audio_tower.layers.{i}.feed_forward2.ffw_layer_1.linear.weight"],
      ["a.blk.{i}.ffn_up_1.{b:*}", "model.audio_tower.layers.{i}.feed_forward2.ffw_layer_1.{b}"],
      ["a.blk.{i}.ffn_down_1.weight", "model.audio_tower.layers.{i}.feed_forward2.ffw_layer_2.linear.weight"],
      ["a.blk.{i}.ffn_down_1.{b:*}", "model.audio_tower.layers.{i}.feed_forward2.ffw_layer_2.{b}"],
      ["a.blk.{i}.conv_pw1.weight", "model.audio_tower.layers.{i}.lconv1d.linear_start.linear.weight"],
      ["a.blk.{i}.conv_pw1.{b:*}", "model.audio_tower.layers.{i}.lconv1d.linear_start.{b}"],
      ["a.blk.{i}.conv_pw2.weight", "model.audio_tower.layers.{i}.lconv1d.linear_end.linear.weight"],
      ["a.blk.{i}.conv_pw2.{b:*}", "model.audio_tower.layers.{i}.lconv1d.linear_end.{b}"],
      ["a.blk.{i}.ffn_norm.weight", "model.audio_tower.layers.{i}.feed_forward1.pre_layer_norm.weight"],
      ["a.blk.{i}.ffn_post_norm.weight", "model.audio_tower.layers.{i}.feed_forward1.post_layer_norm.weight"],
      ["a.blk.{i}.ffn_norm_1.weight", "model.audio_tower.layers.{i}.feed_forward2.pre_layer_norm.weight"],
      ["a.blk.{i}.ffn_post_norm_1.weight", "model.audio_tower.layers.{i}.feed_forward2.post_layer_norm.weight"],
      ["a.blk.{i}.attn_pre_norm.weight", "model.audio_tower.layers.{i}.norm_pre_attn.weight"],
      ["a.blk.{i}.attn_post_norm.weight", "model.audio_tower.layers.{i}.norm_post_attn.weight"],
      ["a.blk.{i}.ln2.weight", "model.audio_tower.layers.{i}.norm_out.weight"],
      ["a.blk.{i}.conv_norm.weight", "model.audio_tower.layers.{i}.lconv1d.pre_layer_norm.weight"],
      ["a.blk.{i}.norm_conv.weight", "model.audio_tower.layers.{i}.lconv1d.conv_norm.weight"],
      ["a.blk.{i}.conv_dw.weight", "model.audio_tower.layers.{i}.lconv1d.depthwise_conv1d.weight"],
      ["a.blk.{i}.attn_k_rel.weight", "model.audio_tower.layers.{i}.self_attn.relative_k_proj.weight"],
      ["a.blk.{i}.per_dim_scale.weight", "model.audio_tower.layers.{i}.self_attn.per_dim_scale"],
    ],
  },
  transforms: [
    // mmproj `gemma4a` stores per_dim_scale softplus'ed: undone before the bf16 rounding below.
    {tensor: "model.audio_tower.layers.{i}.self_attn.per_dim_scale", op: "inv_softplus", when: "gg"},
    // GGUF values as `Weights::from_gguf` stored them: float tensors in bf16 (packed blocks stay).
    {tensor: "{n:*}", op: "round_bf16", when: "gg && len(shape(n)) == 1"},
    {tensor: "{n:*}", op: "to_bf16", when: "gg && len(shape(n)) >= 2 && len(shape(n)) <= 3"},
    // Router input: rms_norm(x) * scale / sqrt(hidden).
    {tensor: "model.language_model.layers.{i}.router.scale", op: "scale", args: {value: "1 / sqrt(hidden)"}},
    {tensor: "model.language_model.layers.{i}.router.per_expert_scale", op: "to_f32"},
    {tensor: "model.language_model.layers.{i}.router.per_expert_scale", op: "reshape", args: {shape: [1, "experts"]}},
    // Expert banks [experts, out, in] as the [experts * out, in] rows `MoeLinear` reads.
    {tensor: "model.language_model.layers.{i}.mlp.experts.{n:*}", op: "reshape",
     args: {shape: [-1, "shape(fmt('model.language_model.layers.{i}.mlp.experts.{n}'))[2]"]}},
    // mmproj patch embedder: the [out, c, y, x] conv kernel as the HF [out, (y, x, c)] linear.
    {tensor: "model.vision_tower.patch_embedder.input_proj.weight", op: "conv_to_linear", args: {order: "k_in"}, when: "gg && v_ok"},
    {tensor: "model.vision_tower.patch_embedder.input_proj.weight", op: "to_bf16", when: "gg && v_ok"},
    // Vision position tables [2 (x, y), size, d] as [size, (x, y) d] rows one gather reads.
    {tensor: "model.vision_tower.patch_embedder.position_embedding_table", op: "transpose", args: {perm: [1, 0, 2]}, when: "v_ok"},
    {tensor: "{t:*}.position_embedding_table", op: "reshape", args: {shape: [0, -1]}},
    // gemma4_unified: [size, 2 (x, y), d] already in row order.
    {tensor: "model.vision_embedder.pos_embedding", op: "reshape", args: {shape: [0, -1]}},
    // Audio q scale per head dim: softplus(per_dim_scale) / (sqrt(head_dim) ln 2).
    {tensor: "model.audio_tower.layers.{i}.self_attn.per_dim_scale", op: "softplus"},
    {tensor: "model.audio_tower.layers.{i}.self_attn.per_dim_scale", op: "scale", args: {value: "a_hd ** -0.5 / ln(2)"}},
    // Audio conv kernels in f32 (bf16-valued from a GGUF); the mmproj depthwise kernel is [d, k].
    {tensor: "model.audio_tower.subsample_conv_projection.layer{i}.conv.weight", op: "round_bf16", when: "gg"},
    {tensor: "model.audio_tower.layers.{i}.lconv1d.depthwise_conv1d.weight", op: "reshape",
     when: "gg && len(shape(fmt('model.audio_tower.layers.{i}.lconv1d.depthwise_conv1d.weight'))) == 2",
     args: {shape: [0, 1, -1]}},
    {tensor: "model.audio_tower.layers.{i}.lconv1d.depthwise_conv1d.weight", op: "to_f32"},
  ],
  constants: {
    "rope.sliding": {gen: "rope_inv_freq", args: {dim: "hd_swa", theta: "theta_swa", kind: "'proportional'",
      factor: "first(rope_swa.factor, 1)"}},
    "rope.full": {gen: "rope_inv_freq", when: "last_full >= 0", args: {dim: "hd_full", theta: "theta_full",
      kind: "'proportional'", partial_rotary_factor: "prf_full", factor: "first(rope_full.factor, 1)"}},
    // The value norm has no learned gain.
    "ones.sliding": {gen: "ones", args: {shape: ["hd_swa"]}},
    "ones.full": {gen: "ones", when: "last_full >= 0", args: {shape: ["hd_full"]}},
    "ple.proj_scale": {gen: "fill", when: "ple_dim > 0", args: {shape: [1], value: "hidden ** -0.5"}},
    "ple.half": {gen: "fill", when: "ple_dim > 0", args: {shape: [1], value: "1 / sqrt(2)"}},
    "vision.rope": {gen: "rope_inv_freq", when: "has_vision", args: {dim: "v_hd // 2", theta: "v_theta"}},
    "vision.ones_hd": {gen: "ones", when: "has_vision", args: {shape: ["v_hd"]}},
    "vision.ones": {gen: "ones", when: "has_vision", args: {shape: ["v_hidden"]}},
    // Audio front end (periodic-Hann DFT, HTK mel filters, log floor) and relative positions.
    "audio.dft": {gen: "dft_matrix", when: "has_audio", args: {frame_length: "a_frame", fft_length: "a_fft"}},
    "audio.mel": {gen: "mel_filters_htk", when: "has_audio", args: {fft_length: "a_fft", mel_bins: "a_mel",
      sampling_rate: "a_rate", min_frequency: "first(a_fe.min_frequency, 0)", max_frequency: "first(a_fe.max_frequency, 8000)"}},
    "audio.mel_floor": {gen: "fill", when: "has_audio", args: {shape: [1], value: "first(a_fe.mel_floor, 1e-3)"}},
    "audio.rel_pos": {gen: "rel_pos_sinusoid", when: "has_audio", args: {left: "a_left", dim: "a_hidden"}},
  },
  // KV-shared layers read an earlier layer's cache: their own k/v (HF keeps them) are never read.
  ignore: ["rope_freqs.weight", "model.language_model.layers.*.self_attn.k_proj.weight",
           "model.language_model.layers.*.self_attn.v_proj.weight",
           "model.language_model.layers.*.self_attn.k_norm.weight",
           // The seq-cls head: read by the `head: 'score'` instance only.
           "score.weight", "norm.weight",
           // A vision tower left off (`vision_on`): its weights go unread.
           {glob: "model.vision_tower.*", when: "has_vision && !vision_on"},
           {glob: "model.embed_vision.*", when: "has_vision && !vision_on"}],
  macros: {
    // ClippableLinear `p` (stem): `{p}.linear.weight` between the optional scalar clamps
    // `{p}.input_min` / `input_max` / `output_min` / `output_max` (a missing bound is the f32 limit).
    clipped_linear: {params: ["x"], body: [
      {op: "Unary", args: {kind: {Clamp: ["first(at(values(p + '.input_min'), 0), -3.4028234663852886e38)",
                                          "first(at(values(p + '.input_max'), 0), 3.4028234663852886e38)"]}},
       in: ["x"], out: "x", name: "in_clamp", when: "has(p + '.input_min') || has(p + '.input_max')"},
      {op: "Linear", in: ["x", "w:{p}.linear.weight"], out: "out", name: "linear"},
      {op: "Unary", args: {kind: {Clamp: ["first(at(values(p + '.output_min'), 0), -3.4028234663852886e38)",
                                          "first(at(values(p + '.output_max'), 0), 3.4028234663852886e38)"]}},
       in: ["out"], out: "out", name: "out_clamp", when: "has(p + '.output_min') || has(p + '.output_max')"},
    ]},
    // Audio subsampling block `p`: 3x3 stride-2 conv over channel planes `[c, t, f]`, then the
    // channel LayerNorm (no bias) and ReLU over rows `[t' * f', c']`.
    gemma4a_sscp: {params: ["x"], body: [
      {op: "Conv2d", args: {stride: [2, 2], padding: [1, 1, 1, 1], dilation: [1, 1], groups: 1}, in: ["x", "w:{p}.conv.weight"], out: "y", name: "conv"},
      {op: "Reshape", args: {shape: ["shape('y')[0]", "shape('y')[1] * shape('y')[2]"]}, in: ["y"], out: "y", name: "flat"},
      {op: "Transpose", args: {perm: [1, 0]}, in: ["y"], out: "y", name: "rows"},
      {op: "LayerNorm", args: {eps: "a_eps"}, in: ["y", "w:{p}.norm.weight"], out: "y", name: "norm"},
      {op: "Unary", args: {kind: "Relu"}, in: ["y"], out: "out", name: "relu"},
    ]},
    // Audio feed-forward half step `p`: x + residual_weight * post_norm(W2 silu(W1 pre_norm(x))).
    gemma4a_ff: {params: ["x"], body: [
      {op: "RmsNorm", args: {eps: "a_eps"}, in: ["x", "w:{p}.pre_layer_norm.weight"], out: "a", name: "pre"},
      {use: "clipped_linear", args: {p: "p + '.ffw_layer_1'"}, in: ["a"], out: "a", name: "w1"},
      {op: "Unary", args: {kind: "Silu"}, in: ["a"], out: "a", name: "silu"},
      {use: "clipped_linear", args: {p: "p + '.ffw_layer_2'"}, in: ["a"], out: "a", name: "w2"},
      {op: "RmsNorm", args: {eps: "a_eps"}, in: ["a", "w:{p}.post_layer_norm.weight"], out: "a", name: "post"},
      {op: "Unary", args: {kind: {Scale: "a_rw"}}, in: ["a"], out: "a", name: "res_scale"},
      {op: "Binary", args: {kind: "Add"}, in: ["x", "a"], out: "out", name: "res"},
    ]},
    // `[n, a_heads * a_hd]` rows as heads `[a_heads, n, a_hd]`. Arg `n`.
    gemma4a_heads: {params: ["x"], body: [
      {op: "Reshape", args: {shape: ["n", "a_heads", "a_hd"]}, in: ["x"], out: "x", name: "split"},
      {op: "Transpose", args: {perm: [1, 0, 2]}, in: ["x"], out: "out", name: "heads"},
    ]},
    // Axial 2-D RoPE of the vision tower over `[np, v_heads * v_hd]`: per head, the first half
    // rotates by the patch column (`i:rope_x`), the second by its row (`i:rope_y`). Arg `np`.
    gemma4v_axial_rope: {params: ["x"], body: [
      {let: {half: "v_hd // 2"}},
      {op: "Reshape", args: {shape: ["np * v_heads", "v_hd"]}, in: ["x"], out: "hx", name: "heads"},
      {op: "Slice", args: {axis: -1, start: 0, end: "half"}, in: ["hx"], out: "lo", name: "x"},
      {op: "Rope", args: {head_dim: "half", rotary_dim: "half", variant: "HalfSplit", mscale: 1}, in: ["lo", "i:rope_x", "c:vision.rope"], out: "lo", name: "x.rope"},
      {op: "Slice", args: {axis: -1, start: "half", end: "v_hd"}, in: ["hx"], out: "hi", name: "y"},
      {op: "Rope", args: {head_dim: "half", rotary_dim: "half", variant: "HalfSplit", mscale: 1}, in: ["hi", "i:rope_y", "c:vision.rope"], out: "hi", name: "y.rope"},
      {op: "Concat", args: {axis: -1}, in: ["lo", "hi"], out: "cat", name: "cat"},
      {op: "Reshape", args: {shape: ["np", "v_heads * v_hd"]}, in: ["cat"], out: "out", name: "flat"},
    ]},
    // Sparse-layer FFN: the dense MLP output `mlp` and the routed experts over `x` (the residual
    // stream after attention), each with its own norm; returns their sum. Arg `p` (layer stem).
    gemma4_moe: {params: ["x", "mlp"], body: [
      {op: "RmsNorm", args: {eps: "eps"}, in: ["mlp", "w:{p}.post_feedforward_layernorm_1.weight"], out: "dense", name: "post_ff_ln_1"},
      {op: "RmsNorm", args: {eps: "eps"}, in: ["x", "w:{p}.pre_feedforward_layernorm_2.weight"], out: "ein", name: "pre_ff_ln_2"},
      {op: "RmsNorm", args: {eps: "eps"}, in: ["x"], out: "unit", name: "router_norm"},
      {op: "Binary", args: {kind: "Mul"}, in: ["unit", "w:{p}.router.scale"], out: "rin", name: "router_in"},
      {op: "Linear", in: ["rin", "w:{p}.router.proj.weight"], out: "logits", name: "router"},
      {op: "TopK", args: {k: "top_k"}, in: ["logits"], out: "ids", name: "topk"},
      {op: "GatherCols", in: ["logits", "ids"], out: "picked", name: "picked"},
      {op: "Softmax", args: {axis: -1}, in: ["picked"], out: "rw", name: "route_w"},
      {block: [
        {op: "GatherCols", in: ["w:{p}.router.per_expert_scale", "ids"], out: "es", name: "expert_scale"},
        {op: "Binary", args: {kind: "Mul"}, in: ["rw", "es"], out: "rw", name: "route_w_scaled"},
      ], when: "has(fmt('{p}.router.per_expert_scale'))"},
      {let: {fused: "has(fmt('{p}.mlp.experts.gate_up_proj'))", ff: "shape(fmt('{p}.mlp.experts.down_proj'))[1]"}},
      {block: [
        {op: "MoeLinear", args: {experts: "experts", top_k: "top_k"}, in: ["ein", "w:{p}.mlp.experts.gate_up_proj", "ids"], out: "gu", name: "expert_gate_up"},
        {op: "Slice", args: {axis: 1, start: 0, end: "ff"}, in: ["gu"], out: "g", name: "expert_gate"},
        {op: "Slice", args: {axis: 1, start: "ff", end: "2 * ff"}, in: ["gu"], out: "u", name: "expert_up"},
      ], when: "fused"},
      {block: [
        {op: "MoeLinear", args: {experts: "experts", top_k: "top_k"}, in: ["ein", "w:{p}.mlp.experts.gate_proj", "ids"], out: "g", name: "expert_gate"},
        {op: "MoeLinear", args: {experts: "experts", top_k: "top_k"}, in: ["ein", "w:{p}.mlp.experts.up_proj", "ids"], out: "u", name: "expert_up"},
      ], when: "!fused"},
      {op: "GeGlu", in: ["g", "u"], out: "act", name: "expert_act"},
      {op: "MoeLinear", args: {experts: "experts", top_k: "top_k"}, in: ["act", "w:{p}.mlp.experts.down_proj", "ids"], out: "down", name: "expert_down"},
      {op: "Reshape", args: {shape: ["rows * top_k", 1]}, in: ["rw"], out: "wc", name: "route_w_col"},
      {op: "Binary", args: {kind: "Mul"}, in: ["down", "wc"], out: "wd", name: "expert_weighted"},
      {op: "Reshape", args: {shape: ["rows", "top_k", "hidden"]}, in: ["wd"], out: "slots", name: "expert_slots"},
      {op: "Reduce", args: {kind: "Sum", axes: [1], keep_dims: false}, in: ["slots"], out: "routed", name: "routed"},
      {op: "RmsNorm", args: {eps: "eps"}, in: ["routed", "w:{p}.post_feedforward_layernorm_2.weight"], out: "sparse", name: "post_ff_ln_2"},
      {op: "Binary", args: {kind: "Add"}, in: ["dense", "sparse"], out: "out", name: "ffn_sum"},
    ]},
  },
  components: {
    text: {
      vars: ["rows", "head"],
      inputs: [
        {name: "token_ids", dtype: "u32", shape: ["rows"]},
        {name: "positions", dtype: "u32", shape: ["rows"]},
        {name: "last_index", dtype: "u32", shape: [1], when: "head == 'score'"},
        // Sliding layers of a prefill pass also see the rest of their image block.
        {name: "visible_end", dtype: "u32", shape: ["rows"], when: "rows > 1"},
        {name: "media_rows", dtype: "f32", shape: ["media", "hidden"], when: "first(media, 0) > 0"},
        {name: "media_index", dtype: "u32", shape: ["media"], when: "first(media, 0) > 0"},
        {name: "media_pad", dtype: "u32", shape: ["media"], gen: "iota", args: {n: "media", start: "pad_id", step: 0},
         when: "first(media, 0) > 0 && ple_dim > 0"},
      ],
      body: [
        {let: {lm: "'model.language_model'"}},
        {op: "Embedding", in: ["w:{lm}.embed_tokens.weight", "i:token_ids"], out: "x", name: "embed"},
        {op: "Unary", args: {kind: {Scale: "embed_scale"}}, in: ["x"], out: "x", name: "embed_scale"},
        {op: "Scatter", args: {axis: 0}, in: ["x", "i:media_index", "i:media_rows"], out: "x", name: "media", when: "first(media, 0) > 0"},
        {block: [
          {op: "Linear", in: ["x", "w:{lm}.per_layer_model_projection.weight"], out: "pp", name: "model.ple.model_proj"},
          {op: "Binary", args: {kind: "Mul"}, in: ["pp", "c:ple.proj_scale"], out: "pp", name: "model.ple.proj_scaled"},
          {op: "RmsNorm", args: {eps: "eps"}, in: ["pp", "w:{lm}.per_layer_projection_norm.weight"], out: "pp", name: "model.ple.proj_norm"},
          {op: "Embedding", in: ["w:{lm}.embed_tokens_per_layer.weight", "i:token_ids"], out: "pe", name: "model.ple.embed"},
          {op: "Unary", args: {kind: {Scale: "sqrt(ple_dim)"}}, in: ["pe"], out: "pe", name: "model.ple.embed_scale"},
          {block: [
            {op: "Embedding", in: ["w:{lm}.embed_tokens_per_layer.weight", "i:media_pad"], out: "pm", name: "model.ple.media"},
            {op: "Unary", args: {kind: {Scale: "sqrt(ple_dim)"}}, in: ["pm"], out: "pm", name: "model.ple.media_scale"},
            {op: "Scatter", args: {axis: 0}, in: ["pe", "i:media_index", "pm"], out: "pe", name: "model.ple.media_scatter"},
          ], when: "first(media, 0) > 0"},
          {op: "Binary", args: {kind: "Add"}, in: ["pp", "pe"], out: "ple", name: "model.ple.add"},
          {op: "Binary", args: {kind: "Mul"}, in: ["ple", "c:ple.half"], out: "ple", name: "model.ple.scaled"},
        ], when: "ple_dim > 0"},
        {repeat: "i", count: "layers", body: [
          {let: {p: "fmt('{lm}.layers.{i}')", n: "fmt('layers.{i}')", sl: "at(types, i) == sl_tag",
                 hd: "shape(fmt('{lm}.layers.{i}.self_attn.q_norm.weight'))[0]",
                 src: "i < first_shared ? i : rfind(types, at(types, i), first_shared)"}},
          {let: {heads: "shape(fmt('{p}.self_attn.q_proj.weight'))[0] // hd",
                 kvh: "shape(fmt('{lm}.layers.{src}.self_attn.k_proj.weight'))[0] // hd",
                 rope: "sl ? 'rope.sliding' : 'rope.full'", ones: "sl ? 'ones.sliding' : 'ones.full'",
                 win: "sl ? window : null"}},
          {use: "alias", in: ["i:visible_end"], out: "ve.{i}", when: "sl && rows > 1"},
          {use: "rms_norm", args: {w: "fmt('{p}.input_layernorm')"}, in: ["x"], out: "a", name: "{n}.input_ln"},
          {op: "Linear", in: ["a", "w:{p}.self_attn.q_proj.weight"], out: "q", name: "{n}.attn.q"},
          {use: "rms_norm", args: {w: "fmt('{p}.self_attn.q_norm')"}, in: ["q"], out: "q", name: "{n}.attn.q_norm"},
          // Pairs (i, i + head_dim/2) over the whole head; proportional rope is the zero tail of
          // inv_freq (identity rotations), not a shorter rotary_dim.
          {op: "Rope", args: {head_dim: "hd", rotary_dim: "hd", variant: "HalfSplit", mscale: 1}, in: ["q", "i:positions", "c:{rope}"], out: "q", name: "{n}.attn.q_rope"},
          {block: [
            {op: "Linear", in: ["a", "w:{p}.self_attn.k_proj.weight"], out: "k", name: "{n}.attn.k"},
            {use: "rms_norm", args: {w: "fmt('{p}.self_attn.k_norm')"}, in: ["k"], out: "kn", name: "{n}.attn.k_norm"},
            {op: "Rope", args: {head_dim: "hd", rotary_dim: "hd", variant: "HalfSplit", mscale: 1}, in: ["kn", "i:positions", "c:{rope}"], out: "kn", name: "{n}.attn.k_rope"},
            {op: "Linear", in: ["a", "w:{p}.self_attn.v_proj.weight"], out: "v", name: "{n}.attn.v", when: "has(fmt('{p}.self_attn.v_proj.weight'))"},
            // attention_k_eq_v: the value is the raw key projection.
            {use: "alias", in: ["k"], out: "v", when: "!has(fmt('{p}.self_attn.v_proj.weight'))"},
            {op: "RmsNorm", args: {eps: "eps"}, in: ["v", "c:{ones}"], out: "v", name: "{n}.attn.v_norm"},
            {state: "kv.{i}.k", shape: ["ctx", "kvh * hd"]},
            {state: "kv.{i}.v", shape: ["ctx", "kvh * hd"]},
            {op: "CachedAttention", args: {heads: "heads", kv_heads: "kvh", head_dim: "hd", v_head_dim: "hd", scale: 1,
               causal: true, window: "win", write: true},
             in: ["q", "kn", "v", "s:kv.{i}.k", "s:kv.{i}.v", "i:positions", "v?:ve.{i}"], out: "att", name: "{n}.attn"},
          ], when: "i < first_shared"},
          {block: [
            {op: "CachedAttention", args: {heads: "heads", kv_heads: "kvh", head_dim: "hd", v_head_dim: "hd", scale: 1,
               causal: true, window: "win", write: false},
             in: ["q", "q", "q", "s:kv.{src}.k", "s:kv.{src}.v", "i:positions", "v?:ve.{i}"], out: "att", name: "{n}.attn"},
          ], when: "i >= first_shared"},
          {op: "Linear", in: ["att", "w:{p}.self_attn.o_proj.weight"], out: "o", name: "{n}.attn.o"},
          {use: "sandwich", args: {w: "fmt('{p}.post_attention_layernorm')"}, in: ["x", "o"], out: "x", name: "{n}.post_attn"},
          {use: "rms_norm", args: {w: "fmt('{p}.pre_feedforward_layernorm')"}, in: ["x"], out: "f", name: "{n}.pre_ff_ln"},
          {use: "mlp_glu", in: ["f"], out: "d", name: "{n}.mlp", args: {act: "'GeluTanh'",
            gate: "fmt('{p}.mlp.gate_proj')", up: "fmt('{p}.mlp.up_proj')", down: "fmt('{p}.mlp.down_proj')"}},
          {use: "gemma4_moe", args: {p: "p"}, in: ["x", "d"], out: "d", name: "{n}.moe", when: "moe"},
          {use: "sandwich", args: {w: "fmt('{p}.post_feedforward_layernorm')"}, in: ["x", "d"], out: "x", name: "{n}.post_ff"},
          {block: [
            {op: "Slice", args: {axis: 1, start: "i * ple_dim", end: "(i + 1) * ple_dim"}, in: ["ple"], out: "pl", name: "{n}.ple.slice"},
            {op: "Linear", in: ["x", "w:{p}.per_layer_input_gate.weight"], out: "pg", name: "{n}.ple.gate"},
            {op: "GeGlu", in: ["pg", "pl"], out: "pg", name: "{n}.ple.act"},
            {op: "Linear", in: ["pg", "w:{p}.per_layer_projection.weight"], out: "po", name: "{n}.ple.proj"},
            {op: "RmsNorm", args: {eps: "eps"}, in: ["po", "w:{p}.post_per_layer_input_norm.weight"], out: "po", name: "{n}.ple.norm"},
            {op: "Binary", args: {kind: "Add"}, in: ["x", "po"], out: "x", name: "{n}.ple.res"},
          ], when: "ple_dim > 0"},
          {op: "Binary", args: {kind: "Mul"}, in: ["x", "w:{p}.layer_scalar"], out: "x", name: "{n}.scaled",
           when: "abs(at(values(fmt('{p}.layer_scalar')), 0) - 1) > 1e-6"},
          {tap: "layer.{i}", in: "x"},
        ]},
        // A prefill pass needs only the last row's logits: slice before the head.
        {op: "Slice", args: {axis: 0, start: "rows - 1", end: "rows"}, in: ["x"], out: "x", name: "last_row", when: "head == 'last' && rows > 1"},
        {op: "Gather", args: {axis: 0}, in: ["x", "i:last_index"], out: "x", name: "last_index", when: "head == 'score'"},
        {op: "RmsNorm", args: {eps: "eps"}, in: ["x", "w:{lm}.norm.weight"], out: "hidden", name: "final_norm"},
        // Gemma4ForSequenceClassification (gevva cross-encoders): the head's own RMSNorm, then the
        // bias-free `score` on row `last_index`.
        {op: "RmsNorm", args: {eps: "eps"}, in: ["hidden", "w:norm.weight"], out: "hidden", name: "score_norm",
         when: "(head == 'score' || head == 'hidden') && has('norm.weight')"},
        {op: "Linear", in: ["hidden", "w:score.weight"], out: "logits", name: "score", when: "head == 'score'"},
        {block: [
          {op: "Linear", in: ["hidden", "w:{lm}.embed_tokens.weight"], out: "logits", name: "lm_head"},
          {op: "Unary", args: {kind: {SoftCap: "softcap"}}, in: ["logits"], out: "logits", name: "logits_softcap", when: "softcap > 0"},
        ], when: "head == 'last' || head == 'all'"},
      ],
      outputs: [{name: "logits", when: "head != 'hidden'"}, {name: "hidden", when: "head == 'hidden'"}],
    },
    // Vision tower: 2-D learned position tables, a bidirectional ViT (clipped linears, q/k/v
    // RMSNorm, axial RoPE, attention scale 1), k x k average pooling * sqrt(hidden), the 26B
    // tower's optional standardization, then `embed_vision` (unit-gain norm + projection).
    // Vars: the patch grid. Input 0: `[np, p*p*3]` patches, `(y, x, c)` inside, in [-1, 1].
    vision: {
      vars: ["grid_h", "grid_w"],
      inputs: [
        {name: "patches", dtype: "f32", shape: ["grid_h * grid_w", "v_in"]},
        {name: "pos_x", dtype: "u32", shape: ["grid_h * grid_w"], gen: "grid_xy", args: {grid_h: "grid_h", grid_w: "grid_w", axis: 0}},
        {name: "pos_y", dtype: "u32", shape: ["grid_h * grid_w"], gen: "grid_xy", args: {grid_h: "grid_h", grid_w: "grid_w", axis: 1}},
        {name: "rope_x", dtype: "u32", shape: ["grid_h * grid_w * v_heads"], gen: "grid_xy",
         args: {grid_h: "grid_h", grid_w: "grid_w", axis: 0, repeat: "v_heads"}},
        {name: "rope_y", dtype: "u32", shape: ["grid_h * grid_w * v_heads"], gen: "grid_xy",
         args: {grid_h: "grid_h", grid_w: "grid_w", axis: 1, repeat: "v_heads"}},
      ],
      body: [
        {let: {vp: "'model.vision_tower'", np: "grid_h * grid_w", d: "v_hidden", k: "v_pool"}},
        {op: "Linear", in: ["i:patches", "w:{vp}.patch_embedder.input_proj.weight"], out: "h", name: "vision.input_proj"},
        {op: "Embedding", in: ["w:{vp}.patch_embedder.position_embedding_table", "i:pos_x"], out: "px", name: "vision.pos_x.rows"},
        {op: "Slice", args: {axis: 1, start: 0, end: "d"}, in: ["px"], out: "px", name: "vision.pos_x.table"},
        {op: "Binary", args: {kind: "Add"}, in: ["h", "px"], out: "h", name: "vision.pos_x"},
        {op: "Embedding", in: ["w:{vp}.patch_embedder.position_embedding_table", "i:pos_y"], out: "py", name: "vision.pos_y.rows"},
        {op: "Slice", args: {axis: 1, start: "d", end: "2 * d"}, in: ["py"], out: "py", name: "vision.pos_y.table"},
        {op: "Binary", args: {kind: "Add"}, in: ["h", "py"], out: "h", name: "vision.pos_y"},
        {repeat: "i", count: "v_layers", body: [
          {let: {p: "fmt('{vp}.encoder.layers.{i}')", n: "fmt('vision.layers.{i}')"}},
          {op: "RmsNorm", args: {eps: "v_eps"}, in: ["h", "w:{p}.input_layernorm.weight"], out: "a", name: "{n}.input_ln"},
          {use: "clipped_linear", args: {p: "p + '.self_attn.q_proj'"}, in: ["a"], out: "q", name: "{n}.q"},
          {use: "clipped_linear", args: {p: "p + '.self_attn.k_proj'"}, in: ["a"], out: "k", name: "{n}.k"},
          {use: "clipped_linear", args: {p: "p + '.self_attn.v_proj'"}, in: ["a"], out: "v", name: "{n}.v"},
          {op: "RmsNorm", args: {eps: "v_eps"}, in: ["q", "w:{p}.self_attn.q_norm.weight"], out: "q", name: "{n}.q_norm"},
          {op: "RmsNorm", args: {eps: "v_eps"}, in: ["k", "w:{p}.self_attn.k_norm.weight"], out: "k", name: "{n}.k_norm"},
          {op: "RmsNorm", args: {eps: "v_eps"}, in: ["v", "c:vision.ones_hd"], out: "v", name: "{n}.v_norm"},
          {use: "gemma4v_axial_rope", args: {np: "np"}, in: ["q"], out: "q", name: "{n}.q_rope"},
          {use: "gemma4v_axial_rope", args: {np: "np"}, in: ["k"], out: "k", name: "{n}.k_rope"},
          {op: "Attention", args: {heads: "v_heads", kv_heads: "v_heads", causal: false, scale: 1}, in: ["q", "k", "v"], out: "att", name: "{n}.attn"},
          {use: "clipped_linear", args: {p: "p + '.self_attn.o_proj'"}, in: ["att"], out: "o", name: "{n}.o"},
          {op: "RmsNorm", args: {eps: "v_eps"}, in: ["o", "w:{p}.post_attention_layernorm.weight"], out: "o", name: "{n}.post_attn_ln"},
          {op: "Binary", args: {kind: "Add"}, in: ["h", "o"], out: "h", name: "{n}.res1"},
          {op: "RmsNorm", args: {eps: "v_eps"}, in: ["h", "w:{p}.pre_feedforward_layernorm.weight"], out: "a", name: "{n}.pre_ff_ln"},
          {use: "clipped_linear", args: {p: "p + '.mlp.gate_proj'"}, in: ["a"], out: "g", name: "{n}.gate"},
          {use: "clipped_linear", args: {p: "p + '.mlp.up_proj'"}, in: ["a"], out: "u", name: "{n}.up"},
          // gelu(gate) * up as Unary + Mul: a literal `GeGlu` lets the megakernel MLP fusion claim
          // the block, and that kernel is single-row only.
          {op: "Unary", args: {kind: "GeluTanh"}, in: ["g"], out: "g", name: "{n}.gelu"},
          {op: "Binary", args: {kind: "Mul"}, in: ["g", "u"], out: "g", name: "{n}.glu"},
          {use: "clipped_linear", args: {p: "p + '.mlp.down_proj'"}, in: ["g"], out: "m", name: "{n}.down"},
          {op: "RmsNorm", args: {eps: "v_eps"}, in: ["m", "w:{p}.post_feedforward_layernorm.weight"], out: "m", name: "{n}.post_ff_ln"},
          {op: "Binary", args: {kind: "Add"}, in: ["h", "m"], out: "h", name: "{n}.res2"},
        ]},
        {op: "Transpose", args: {perm: [1, 0]}, in: ["h"], out: "t", name: "vision.pool.t"},
        {op: "Reshape", args: {shape: ["d", "grid_h", "grid_w"]}, in: ["t"], out: "t", name: "vision.pool.grid"},
        {op: "AvgPool2d", args: {kernel: ["k", "k"], stride: ["k", "k"]}, in: ["t"], out: "t", name: "vision.pool"},
        {op: "Unary", args: {kind: {Scale: "sqrt(d)"}}, in: ["t"], out: "t", name: "vision.pool.scale"},
        {op: "Reshape", args: {shape: ["d", "(grid_h // k) * (grid_w // k)"]}, in: ["t"], out: "t", name: "vision.pool.flat"},
        {op: "Transpose", args: {perm: [1, 0]}, in: ["t"], out: "x", name: "vision.pool.rows"},
        {op: "RmsNorm", args: {eps: "v_eps"}, in: ["x", "c:vision.ones"], out: "x", name: "vision.embed_norm"},
        {op: "Linear", in: ["x", "w:model.embed_vision.embedding_projection.weight"], out: "embeds", name: "vision.embed"},
      ],
      outputs: ["embeds"],
    },
    // Audio conformer: the log-mel front end (Hann-windowed DFT magnitude, HTK mel filters,
    // ln(e + mel_floor), padding frames zeroed), two 3x3 stride-2 conv blocks (channel LayerNorm,
    // ReLU), conformer layers (half-step feed-forwards, chunked local attention with relative
    // positions, per-dim q scale and a logit cap, light depthwise conv), then output_proj and
    // `embed_audio` (unit-gain norm + projection) over the valid rows. Vars: the log_mel grid.
    // Input 0: `[frames, frame_length]` framed samples (valid frames form a prefix).
    audio: {
      vars: ["frames", "valid_frames", "tokens"],
      inputs: [
        {name: "samples", dtype: "f32", shape: ["frames", "a_frame"]},
        {name: "frame_mask", dtype: "f32", shape: ["frames", "a_mel"], gen: "validity_mask",
         args: {rows: "frames", cols: "a_mel", valid_rows: "valid_frames"}},
        // Validity of the first conv block's output (every 2nd frame), one row per frame.
        {name: "conv_mask", dtype: "f32", shape: [1, "((frames - 1) // 2 + 1) * a_f1"], gen: "validity_mask",
         args: {rows: "(frames - 1) // 2 + 1", cols: "a_f1", valid_rows: "(valid_frames + 1) // 2"}},
        // Query i sees the valid keys i - left < j <= i (every 4th frame: `tokens` valid rows).
        {name: "attn_bias", dtype: "f32", shape: ["(frames - 1) // 4 + 1", "(frames - 1) // 4 + 1"], gen: "local_window_bias",
         args: {t: "(frames - 1) // 4 + 1", left: "a_left", valid: "tokens"}},
        {name: "rel_index", dtype: "u32", shape: ["a_heads * ((frames - 1) // 4 + 1) ** 2"], gen: "rel_score_index",
         args: {heads: "a_heads", t: "(frames - 1) // 4 + 1", left: "a_left", valid: "tokens"}},
      ],
      body: [
        {let: {ap: "'model.audio_tower'", t1: "(frames - 1) // 2 + 1", t: "(frames - 1) // 4 + 1", d: "a_hidden"}},
        {op: "Linear", in: ["i:samples", "c:audio.dft"], out: "s", name: "audio.dft"},
        {op: "Slice", args: {axis: -1, start: 0, end: "a_bins"}, in: ["s"], out: "re", name: "audio.dft.re"},
        {op: "Slice", args: {axis: -1, start: "a_bins", end: "2 * a_bins"}, in: ["s"], out: "im", name: "audio.dft.im"},
        {op: "Binary", args: {kind: "Mul"}, in: ["re", "re"], out: "re", name: "audio.dft.re2"},
        {op: "Binary", args: {kind: "Mul"}, in: ["im", "im"], out: "im", name: "audio.dft.im2"},
        {op: "Binary", args: {kind: "Add"}, in: ["re", "im"], out: "s", name: "audio.dft.pow"},
        {op: "Unary", args: {kind: "Sqrt"}, in: ["s"], out: "s", name: "audio.dft.mag"},
        {op: "Linear", in: ["s", "c:audio.mel"], out: "m", name: "audio.mel"},
        {op: "Binary", args: {kind: "Add"}, in: ["m", "c:audio.mel_floor"], out: "m", name: "audio.mel.floor"},
        {op: "Unary", args: {kind: "Ln"}, in: ["m"], out: "m", name: "audio.mel.ln"},
        {op: "Binary", args: {kind: "Mul"}, in: ["m", "i:frame_mask"], out: "m", name: "audio.mel.mask"},
        {op: "Reshape", args: {shape: [1, "frames", "a_mel"]}, in: ["m"], out: "x", name: "audio.mel.plane"},
        {use: "gemma4a_sscp", args: {p: "ap + '.subsample_conv_projection.layer0'"}, in: ["x"], out: "x", name: "audio.sscp0"},
        // Back to channel planes with the padding frames zeroed for the second block.
        {op: "Transpose", args: {perm: [1, 0]}, in: ["x"], out: "x", name: "audio.sscp0.t"},
        {op: "Binary", args: {kind: "Mul"}, in: ["x", "i:conv_mask"], out: "x", name: "audio.sscp0.mask"},
        {op: "Reshape", args: {shape: ["shape('x')[0]", "t1", "a_f1"]}, in: ["x"], out: "x", name: "audio.sscp0.grid"},
        {use: "gemma4a_sscp", args: {p: "ap + '.subsample_conv_projection.layer1'"}, in: ["x"], out: "x", name: "audio.sscp1"},
        // Rows (t, f) -> one row per frame of (f, c).
        {op: "Reshape", args: {shape: ["t", "shape('x')[0] * shape('x')[1] // t"]}, in: ["x"], out: "x", name: "audio.sscp.flat"},
        {op: "Linear", in: ["x", "w:{ap}.subsample_conv_projection.input_proj_linear.weight"], out: "h", name: "audio.in_proj"},
        {repeat: "i", count: "a_layers", body: [
          {let: {p: "fmt('{ap}.layers.{i}')", n: "fmt('audio.layers.{i}')"}},
          {let: {kz: "shape(p + '.lconv1d.depthwise_conv1d.weight')[2]"}},
          {use: "gemma4a_ff", args: {p: "p + '.feed_forward1'"}, in: ["h"], out: "h", name: "{n}.ff1"},
          // Local attention: scores = softcap(q.k + q.rel[distance]) over the window, softmax, . v.
          {op: "RmsNorm", args: {eps: "a_eps"}, in: ["h", "w:{p}.norm_pre_attn.weight"], out: "a", name: "{n}.attn_pre"},
          {use: "clipped_linear", args: {p: "p + '.self_attn.q_proj'"}, in: ["a"], out: "q", name: "{n}.q"},
          {use: "clipped_linear", args: {p: "p + '.self_attn.k_proj'"}, in: ["a"], out: "k", name: "{n}.k"},
          {use: "clipped_linear", args: {p: "p + '.self_attn.v_proj'"}, in: ["a"], out: "v", name: "{n}.v"},
          {op: "Reshape", args: {shape: ["t * a_heads", "a_hd"]}, in: ["q"], out: "q", name: "{n}.q_dims"},
          {op: "Binary", args: {kind: "Mul"}, in: ["q", "w:{p}.self_attn.per_dim_scale"], out: "q", name: "{n}.q_scaled"},
          {op: "Unary", args: {kind: {Scale: "ln(1 + exp(1)) / ln(2)"}}, in: ["k"], out: "k", name: "{n}.k_scaled"},
          {op: "Linear", in: ["c:audio.rel_pos", "w:{p}.self_attn.relative_k_proj.weight"], out: "r", name: "{n}.rel"},
          {use: "gemma4a_heads", args: {n: "t"}, in: ["q"], out: "q", name: "{n}.qh"},
          {use: "gemma4a_heads", args: {n: "t"}, in: ["k"], out: "k", name: "{n}.kh"},
          {use: "gemma4a_heads", args: {n: "t"}, in: ["v"], out: "v", name: "{n}.vh"},
          {use: "gemma4a_heads", args: {n: "a_left + 1"}, in: ["r"], out: "r", name: "{n}.rh"},
          {op: "MatMul", args: {transpose_a: false, transpose_b: true}, in: ["q", "k"], out: "s", name: "{n}.qk"},
          // q . rel for every (query, distance); each local pair picks its distance's score.
          {op: "MatMul", args: {transpose_a: false, transpose_b: true}, in: ["q", "r"], out: "sr", name: "{n}.qr"},
          {op: "Reshape", args: {shape: ["a_heads * t * (a_left + 1)"]}, in: ["sr"], out: "sr", name: "{n}.qr.flat"},
          {op: "Gather", args: {axis: 0}, in: ["sr", "i:rel_index"], out: "sr", name: "{n}.qr.pick"},
          {op: "Reshape", args: {shape: ["a_heads", "t", "t"]}, in: ["sr"], out: "sr", name: "{n}.qr.grid"},
          {op: "Binary", args: {kind: "Add"}, in: ["s", "sr"], out: "s", name: "{n}.scores"},
          {op: "Unary", args: {kind: {SoftCap: "a_cap"}}, in: ["s"], out: "s", name: "{n}.softcap"},
          {op: "Binary", args: {kind: "Add"}, in: ["s", "i:attn_bias"], out: "s", name: "{n}.masked"},
          {op: "Softmax", args: {axis: -1}, in: ["s"], out: "s", name: "{n}.softmax"},
          {op: "MatMul", args: {transpose_a: false, transpose_b: false}, in: ["s", "v"], out: "o", name: "{n}.pv"},
          {op: "Transpose", args: {perm: [1, 0, 2]}, in: ["o"], out: "o", name: "{n}.o_t"},
          {op: "Reshape", args: {shape: ["t", "d"]}, in: ["o"], out: "o", name: "{n}.o_flat"},
          {use: "clipped_linear", args: {p: "p + '.self_attn.post'"}, in: ["o"], out: "o", name: "{n}.post"},
          {op: "RmsNorm", args: {eps: "a_eps"}, in: ["o", "w:{p}.norm_post_attn.weight"], out: "o", name: "{n}.attn_post"},
          {op: "Binary", args: {kind: "Add"}, in: ["h", "o"], out: "h", name: "{n}.attn_res"},
          // Light conv: GLU, causal depthwise conv over time, norm, SiLU, projection.
          {op: "RmsNorm", args: {eps: "a_eps"}, in: ["h", "w:{p}.lconv1d.pre_layer_norm.weight"], out: "a", name: "{n}.lc_pre"},
          {use: "clipped_linear", args: {p: "p + '.lconv1d.linear_start'"}, in: ["a"], out: "g", name: "{n}.lc_start"},
          {op: "Slice", args: {axis: -1, start: 0, end: "d"}, in: ["g"], out: "ga", name: "{n}.lc_a"},
          {op: "Slice", args: {axis: -1, start: "d", end: "2 * d"}, in: ["g"], out: "gb", name: "{n}.lc_b"},
          {op: "Unary", args: {kind: "Sigmoid"}, in: ["gb"], out: "gb", name: "{n}.lc_gate"},
          {op: "Binary", args: {kind: "Mul"}, in: ["ga", "gb"], out: "g", name: "{n}.lc_glu"},
          {op: "Transpose", args: {perm: [1, 0]}, in: ["g"], out: "g", name: "{n}.lc_glu.t"},
          {op: "Conv1d", args: {stride: 1, padding: ["kz - 1", 0], dilation: 1, groups: "d"},
           in: ["g", "w:{p}.lconv1d.depthwise_conv1d.weight"], out: "g", name: "{n}.lc_dw"},
          {op: "Transpose", args: {perm: [1, 0]}, in: ["g"], out: "g", name: "{n}.lc_dw.t"},
          {op: "RmsNorm", args: {eps: "a_eps"}, in: ["g", "w:{p}.lconv1d.conv_norm.weight"], out: "g", name: "{n}.lc_norm"},
          {op: "Unary", args: {kind: "Silu"}, in: ["g"], out: "g", name: "{n}.lc_silu"},
          {use: "clipped_linear", args: {p: "p + '.lconv1d.linear_end'"}, in: ["g"], out: "g", name: "{n}.lc_end"},
          {op: "Binary", args: {kind: "Add"}, in: ["h", "g"], out: "h", name: "{n}.lc_res"},
          {use: "gemma4a_ff", args: {p: "p + '.feed_forward2'"}, in: ["h"], out: "h", name: "{n}.ff2"},
          {op: "RmsNorm", args: {eps: "a_eps"}, in: ["h", "w:{p}.norm_out.weight"], out: "h", name: "{n}.out_norm"},
        ]},
        // Rows past the valid prefix are padding.
        {op: "Slice", args: {axis: 0, start: 0, end: "tokens"}, in: ["h"], out: "h", name: "audio.valid", when: "tokens < t"},
        {op: "Linear", in: ["h", "w:{ap}.output_proj.weight", "w:{ap}.output_proj.bias"], out: "o", name: "audio.out_proj"},
        {op: "RmsNorm", args: {eps: "a_eps"}, in: ["o"], out: "o", name: "audio.embed_norm"},
        {op: "Linear", in: ["o", "w:model.embed_audio.embedding_projection.weight"], out: "embeds", name: "audio.embed"},
      ],
      outputs: ["embeds"],
    },
  },
  runtime: {bidir_media_blocks: true, ffn_weights: ["model.language_model.layers.*.mlp.*"],
    mmproj: true,
    // gevva cross-encoders (`tokenize_nli_pair_safe`): `<bos>Premise: {text}\nHypothesis: {pair}\nPrediction:`.
    seqcls: {head: "score", pooling: "last_nonpad",
      pair: {bos: "tc.bos_token_id", parts: ["Premise: ", "{text}", "\nHypothesis: ", "{pair}", "\nPrediction:"],
             strip: ["<|image|>", "<image|>", "<|image_pad|>", "<|vision_start|>", "<|vision_end|>"]}},
    media: {
      image: {
        when: "vision_on",
        component: "vision",
        // Pixels 2 * (v / 255 - 0.5).
        preprocess: {kind: "soft_token_budget", patch: "v_patch", pool: "v_pool", max_soft_tokens: "v_max_soft",
                     norm: {mean: [0.5, 0.5, 0.5], std: [0.5, 0.5, 0.5]}},
        expand: {kind: "repeat_between", placeholder: "first(cfg.image_token_id, token('<|image|>'))",
                 open: "first(cfg.boi_token_id, token('<|image>'))", close: "first(cfg.eoi_token_id, token('<image|>'))"},
        bidirectional: "bidir_vision",
      },
      // Gemma4AudioFeatureExtractor framing: 30 s at most, padded to 128 samples; every 4th frame
      // (two stride-2 convs) is a soft token.
      audio: {
        when: "has_audio",
        component: "audio",
        preprocess: {kind: "log_mel", sampling_rate: "a_rate", frame_length: "a_frame", hop_length: "first(a_fe.hop_length, 160)",
                     pad_multiple: 128, max_samples: 480000, token_stride: 4},
        // gemma-4-12B's config spells the close id `eoa_token_index`.
        expand: {kind: "repeat_between", placeholder: "first(cfg.audio_token_id, token('<|audio|>'))",
                 open: "first(cfg.boa_token_id, token('<|audio>'))",
                 close: "first(cfg.eoa_token_id, cfg.eoa_token_index, token('<audio|>'))"},
      },
    },
  },
}
